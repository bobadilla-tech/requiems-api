<% content_for :title, t('apis.index.api_directory_requiems_api') %>
<% content_for :description, "Browse 64+ production-ready APIs across validation, finance, networking, places, text, and more. One API key unlocks the entire catalog." %>
<% content_for :head do %>
  <script type="application/ld+json"><%= collection_json_ld(
    name: "API Directory",
    items: live_apis.map { |api| { name: api["name"], url: api_path(api["id"]) } }
  ).html_safe %></script>
<% end %>
<div class="min-h-screen flex bg-gray-50 dark:bg-gray-900">
  <!-- Sidebar -->
  <aside class="hidden lg:block w-52 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 flex-shrink-0">
    <div class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto">
      <%= render 'partials/apis_index/sidebar', categories: @categories_with_apis %>
    </div>
  </aside>

  <!-- Main Content Area -->
  <div class="flex-1 apis-content">
    <!-- Page Header -->
    <div class="text-center mb-10 max-w-3xl mx-auto">
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100 mb-3"><%= t('apis_index.header.page_heading') %></h1>
      <p class="text-base text-gray-600 dark:text-gray-400">
        <%= t('apis_index.header.intro_prefix') %>
        <% if user_signed_in? %>
          <%= t('apis_index.header.intro_signed_in') %>
        <% else %>
          <%= t('apis_index.header.intro_signed_out_html',
                link: link_to(t('apis_index.header.signup_cta_html'), new_user_registration_path,
                              class: "font-semibold text-blue-600 hover:text-blue-700 dark:text-blue-400 dark:hover:text-blue-300")) %>
        <% end %>
      </p>
    </div>

    <%= render 'partials/apis_index/systems_section' %>

    <%= render 'partials/apis_index/most_popular', apis: @popular_apis %>

    <% @categories_with_apis.each do |category| %>
      <% category_apis = @apis_by_category[category["id"]] || [] %>
      <%= render 'partials/apis_index/category_section', category: category, apis: category_apis %>
    <% end %>
  </div>
</div>
