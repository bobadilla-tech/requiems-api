<!DOCTYPE html>
<html lang="en">
<head>
  <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;-webkit-font-smoothing:antialiased;">

  <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f3f4f6;padding:32px 16px;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;">

          <!-- Header -->
          <tr>
            <td style="background:linear-gradient(135deg,#4f46e5 0%,#7c3aed 100%);border-radius:12px 12px 0 0;padding:32px 40px;">
              <p style="margin:0 0 4px 0;font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:#c7d2fe;">Contact Form</p>
              <h1 style="margin:0 0 8px 0;font-size:26px;font-weight:700;color:#ffffff;line-height:1.2;">New Contact Submission</h1>
              <p style="margin:0;font-size:14px;color:#e0e7ff;line-height:1.5;">Via requiemsapi.com/contact — reply directly to respond.</p>
            </td>
          </tr>

          <!-- Inquiry Type Badge -->
          <tr>
            <td style="background-color:#eef2ff;border-left:4px solid #6366f1;padding:16px 40px;">
              <p style="margin:0;font-size:13px;color:#3730a3;">
                <strong style="color:#3730a3;">Inquiry type:</strong>
                <span style="display:inline-block;margin-left:6px;background-color:#e0e7ff;color:#4338ca;padding:2px 10px;border-radius:9999px;font-size:12px;font-weight:600;">
                  <%= @inquiry[:inquiry].presence || "General" %>
                </span>
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff;padding:32px 40px 8px 40px;">

              <!-- Name -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
                <tr>
                  <td style="padding-bottom:6px;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#9ca3af;">Name</td>
                </tr>
                <tr>
                  <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:14px 16px;font-size:15px;font-weight:700;color:#111827;">
                    <%= @inquiry[:name] %>
                  </td>
                </tr>
              </table>

              <!-- Email -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
                <tr>
                  <td style="padding-bottom:6px;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#9ca3af;">Email</td>
                </tr>
                <tr>
                  <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:14px 16px;font-size:14px;">
                    <a href="mailto:<%= @inquiry[:email] %>" style="color:#4f46e5;text-decoration:none;font-weight:500;"><%= @inquiry[:email] %></a>
                  </td>
                </tr>
              </table>

              <!-- Message -->
              <table width="100%" cellpadding="0" cellspacing="0" style="margin-bottom:20px;">
                <tr>
                  <td style="padding-bottom:6px;font-size:11px;font-weight:600;letter-spacing:0.06em;text-transform:uppercase;color:#9ca3af;">Message</td>
                </tr>
                <tr>
                  <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-left:3px solid #6366f1;border-radius:8px;padding:14px 16px;font-size:14px;color:#374151;line-height:1.7;">
                    <%= simple_format(@inquiry[:message]) %>
                  </td>
                </tr>
              </table>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="background-color:#ffffff;border-top:1px solid #f3f4f6;padding:20px 40px 32px 40px;border-radius:0 0 12px 12px;">
              <p style="margin:0 0 6px 0;font-size:13px;color:#6b7280;">
                <strong style="color:#374151;">Submitted:</strong> <%= @timestamp.strftime("%B %d, %Y at %I:%M %p %Z") %>
              </p>
              <p style="margin:0;font-size:12px;color:#9ca3af;">
                Reply directly to this email to reach <%= @inquiry[:name] %>.
              </p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
