<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% if !user_signed_in? && ENV["GA4_MEASUREMENT_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA4_MEASUREMENT_ID"] %>"></script>
    
      <script>
        window.dataLayer = window.dataLayer || [];
      
        function gtag(){dataLayer.push(arguments);}
      
        gtag('js', new Date());
        gtag('config', '<%= ENV["GA4_MEASUREMENT_ID"] %>');
      </script>
    <% end %>

    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        var colorSchema = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (theme === 'dark' || (!theme && colorSchema)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <title><%= content_for(:title) || "Requiems API" %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Requiems API">
    <meta name="mobile-web-app-capable" content="yes">
    
    <% _page_title = content_for?(:title) ? content_for(:title) : "Requiems API: All-in-one backend for SaaS products" %>
    <% _page_description = content_for?(:description) ? content_for(:description) : "Authentication, validation, fraud detection, payments intelligence, and global data — one API key for your entire SaaS stack." %>
    
    <meta name="description" content="<%= _page_description %>">

    <meta property="og:site_name" content="Requiems API">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://requiems.xyz<%= request.path %>">
    <meta property="og:title" content="<%= content_for?(:og_title) ? content_for(:og_title) : _page_title %>">
    <meta property="og:description" content="<%= content_for?(:og_description) ? content_for(:og_description) : _page_description %>">
    <meta property="og:image" content="https://requiems.xyz/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= content_for?(:og_title) ? content_for(:og_title) : _page_title %>">
    <meta name="twitter:description" content="<%= content_for?(:og_description) ? content_for(:og_description) : _page_description %>">
    <meta name="twitter:image" content="https://requiems.xyz/og-image.png">
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= seo_head_tags %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "logo.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "logo.png", rel: "apple-touch-icon" %>
    <link rel="shortcut icon" href="/favicon.ico">

    <script type="application/ld+json"><%= organization_json_ld.html_safe %></script>
    <script type="application/ld+json"><%= website_json_ld.html_safe %></script>
    <% if (bc = breadcrumb_json_ld) %>
      <script type="application/ld+json"><%= bc.html_safe %></script>
    <% end %>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github-dark.min.css">
    <%= javascript_importmap_tags %>
    
  </head>

  <body class="bg-gray-50 dark:bg-gray-900 flex flex-col min-h-screen" data-controller="search-shortcut">
    <%# Flash messages %>
    <% if notice.present? || alert.present? %>
      <div class="fixed top-20 right-4 z-50 space-y-2 max-w-md">
        <% if notice.present? %>
          <div class="bg-green-50 dark:bg-green-900/20 border-l-4 border-green-400 dark:border-green-600 p-4 shadow-md rounded-md" data-controller="flash" data-flash-delay-value="5000">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-green-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-green-700 dark:text-green-300"><%= notice %></p>
              </div>
              <button type="button" class="ml-auto" data-action="click->flash#close">
                <span class="text-green-500 hover:text-green-700">×</span>
              </button>
            </div>
          </div>
        <% end %>

        <% if alert.present? %>
          <div class="bg-red-50 dark:bg-red-900/20 border-l-4 border-red-400 dark:border-red-600 p-4 shadow-md rounded-md" data-controller="flash" data-flash-delay-value="5000">
            <div class="flex items-center">
              <div class="flex-shrink-0">
                <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="ml-3">
                <p class="text-sm text-red-700 dark:text-red-300"><%= alert %></p>
              </div>
              <button type="button" class="ml-auto" data-action="click->flash#close">
                <span class="text-red-500 hover:text-red-700">×</span>
              </button>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Global navigation %>
    <%= render "layouts/navbar" %>

    <%# Main content %>
    <main class="flex-1">
      <%= yield %>
    </main>

    <%# Global footer %>
    <%= render "layouts/footer" %>
  </body>
</html>
