<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% if !user_signed_in? && ENV["GA4_MEASUREMENT_ID"].present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA4_MEASUREMENT_ID"] %>"></script>
    
      <script>
        window.dataLayer = window.dataLayer || [];
      
        function gtag(){dataLayer.push(arguments);}
      
        gtag('js', new Date());
        gtag('config', '<%= ENV["GA4_MEASUREMENT_ID"] %>');
      </script>
    <% end %>

    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        var colorSchema = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (theme === 'dark' || (!theme && colorSchema)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <title><%= page_title %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Requiems API">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= page_description %>">

    <%= og_meta_tags %>
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= seo_head_tags %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "logo.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "logo.png", rel: "apple-touch-icon" %>
    <link rel="shortcut icon" href="/favicon.ico">

    <%= json_ld_tags %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/highlight.js@11.9.0/styles/github-dark.min.css">
    <%= javascript_importmap_tags %>
    
  </head>

  <body class="bg-gray-50 dark:bg-gray-900 flex flex-col min-h-screen" data-controller="search-shortcut">
    <%= render "partials/shared/flash_toast" -%>
    <%= render "partials/shared/ai_skills_banner" -%>
    <%= render "layouts/navbar" %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
