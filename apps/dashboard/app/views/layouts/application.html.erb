<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <% if !user_signed_in? && ENV["GA4_MEASUREMENT_ID"].present? %>
      <script>
        (function() {
          // Defer GTM's bootstrap off the critical rendering path: it competes
          // with first paint / interaction otherwise. requestIdleCallback is the
          // primary path, but Safari/WebKit ships no requestIdleCallback at all,
          // so setTimeout is a first-class path here too, not just a fallback —
          // feature detection naturally routes all Safari traffic through it.
          var loaded = false;
          function loadGTM() {
            if (loaded) return;
            loaded = true;

            window.dataLayer = window.dataLayer || [];
            window.gtag = window.gtag || function() { dataLayer.push(arguments); };
            gtag('js', new Date());
            gtag('config', '<%= ENV["GA4_MEASUREMENT_ID"] %>');

            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://www.googletagmanager.com/gtag/js?id=<%= ENV["GA4_MEASUREMENT_ID"] %>';
            document.head.appendChild(s);
          }

          var scheduled = false;
          function schedule() {
            if (scheduled) return;
            scheduled = true;
            if ('requestIdleCallback' in window) {
              requestIdleCallback(loadGTM, { timeout: 4000 });
            } else {
              setTimeout(loadGTM, 1500);
            }
          }

          if (document.readyState === 'complete') {
            schedule();
          } else {
            window.addEventListener('load', schedule, { once: true });
          }
          [ 'pointerdown', 'keydown', 'touchstart' ].forEach(function(evt) {
            window.addEventListener(evt, schedule, { once: true, passive: true });
          });
        })();
      </script>
    <% end %>

    <script>
      (function() {
        var theme = localStorage.getItem('theme');
        var colorSchema = window.matchMedia('(prefers-color-scheme: dark)').matches;

        if (theme === 'dark' || (!theme && colorSchema)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <script>
      // Keep this key in sync with STORAGE_KEY in ai_skills_banner_controller.js.
      (function() {
        try {
          var mutedUntil = localStorage.getItem('ai-skills-banner-dismissed-until');
          if (mutedUntil && Date.now() < Number(mutedUntil)) {
            document.documentElement.classList.add('hide-ai-skills-banner');
          }
        } catch (e) {
          // localStorage unavailable — fail open, banner shows normally.
        }
      })();
    </script>
    <style>.hide-ai-skills-banner #ai-skills-banner { display: none; }</style>

    <title><%= page_title %></title>

    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Requiems API">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= page_description %>">

    <%= og_meta_tags %>
    
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%= seo_head_tags %>

    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <%= favicon_link_tag "logo.png", rel: "icon", type: "image/png" %>
    <%= favicon_link_tag "logo.png", rel: "apple-touch-icon" %>
    <link rel="shortcut icon" href="/favicon.ico">

    <%= json_ld_tags %>

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
  </head>

  <body class="bg-gray-50 dark:bg-gray-900 flex flex-col min-h-screen" data-controller="search-shortcut">
    <%= render "partials/shared/flash_toast" -%>
    <%= render "partials/shared/ai_skills_banner" -%>
    <%= render "layouts/navbar" %>

    <main class="flex-1">
      <%= yield %>
    </main>

    <%= render "layouts/footer" %>
  </body>
</html>
