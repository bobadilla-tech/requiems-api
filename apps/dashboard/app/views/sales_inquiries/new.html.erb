<% content_for :title, t('sales_inquiries.new.talk_to_sales_requiems_api') %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900">
  <!-- Hero Header -->
  <div class="bg-gradient-to-br from-indigo-900 via-indigo-800 to-purple-900 text-white py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-white/10 text-white/90 border border-white/20 mb-6">
        <%= t('sales_inquiries.new.hero_badge') %>
      </div>
      <h1 class="text-4xl sm:text-5xl font-bold mb-4"><%= t('sales_inquiries.new.heading') %></h1>
      <p class="text-xl text-indigo-200 max-w-2xl mx-auto">
        <%= t('sales_inquiries.new.description') %>
      </p>
    </div>
  </div>

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 pb-16">
    <!-- Schedule Call Card -->
    <div class="-mt-6 mb-10">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-xl border border-gray-100 dark:border-gray-700 p-8">
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6">
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-14 h-14 rounded-full bg-gradient-to-br from-orange-400 to-amber-500 flex items-center justify-center shadow-md">
              <svg class="h-7 w-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-1">
                <%= t('sales_inquiries.new.schedule_card.heading') %>
              </h2>
              <p class="text-gray-600 dark:text-gray-400 font-medium">
                <%= t('sales_inquiries.new.schedule_card.subtitle') %>
              </p>
              <div class="flex items-center gap-2 mt-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-green-500 mr-1.5"></span>
                  <%= t('sales_inquiries.new.schedule_card.available') %>
                </span>
                <span class="text-xs text-gray-500 dark:text-gray-400">· <%= t('sales_inquiries.new.schedule_card.duration') %></span>
              </div>
            </div>
          </div>
          <div class="flex-shrink-0">
            <a href="<%= cal_com_strategy_url %>" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center px-6 py-3 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white font-semibold rounded-xl shadow-md hover:shadow-lg transition-all duration-200 gap-2">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <%= t('sales_inquiries.new.schedule_card.cta') %>
              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature Cards -->
    <div class="grid md:grid-cols-3 gap-6 mb-10">
      <div class="bg-gradient-to-br from-blue-50 to-indigo-50 dark:from-blue-900/20 dark:to-indigo-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-6">
        <div class="flex items-center mb-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <h3 class="ml-3 text-base font-bold text-gray-900 dark:text-gray-100"><%= t('sales_inquiries.new.enterprise_scale_apis') %></h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm">
          High-volume access, custom rate limits, and dedicated infrastructure designed for enterprise workloads.
        </p>
      </div>

      <div class="bg-gradient-to-br from-green-50 to-emerald-50 dark:from-green-900/20 dark:to-emerald-900/20 border border-green-200 dark:border-green-800 rounded-xl p-6">
        <div class="flex items-center mb-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          </div>
          <h3 class="ml-3 text-base font-bold text-gray-900 dark:text-gray-100"><%= t('sales_inquiries.new.enterprise_security_privacy_and') %></h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm">
          Stateless security architecture, GDPR-aligned design, and full compliance documentation.
        </p>
      </div>

      <div class="bg-gradient-to-br from-purple-50 to-pink-50 dark:from-purple-900/20 dark:to-pink-900/20 border border-purple-200 dark:border-purple-800 rounded-xl p-6">
        <div class="flex items-center mb-3">
          <div class="flex-shrink-0">
            <svg class="h-8 w-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/>
            </svg>
          </div>
          <h3 class="ml-3 text-base font-bold text-gray-900 dark:text-gray-100"><%= t('sales_inquiries.new.enterprise_dedicated_support') %></h3>
        </div>
        <p class="text-gray-700 dark:text-gray-300 text-sm">
          Dedicated support, guaranteed response times, and direct access to our engineering team.
        </p>
      </div>
    </div>

    <!-- Divider -->
    <div class="flex items-center gap-4 my-8">
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-700"></div>
      <span class="text-sm font-medium text-gray-500 dark:text-gray-400 px-2">
        <%= t('sales_inquiries.new.or_fill_form') %>
      </span>
      <div class="flex-1 h-px bg-gray-200 dark:bg-gray-700"></div>
    </div>

    <!-- Flash Messages -->
    <% if flash[:alert] %>
      <div class="bg-red-50 dark:bg-red-900/20 border border-red-200 dark:border-red-800 rounded-xl p-4 mb-6">
        <div class="flex items-start">
          <svg class="h-5 w-5 text-red-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <p class="text-sm text-red-800 dark:text-red-300"><%= flash[:alert] %></p>
        </div>
      </div>
    <% end %>

    <!-- Form Section -->
    <div class="bg-white dark:bg-gray-800 rounded-2xl shadow-lg border border-gray-100 dark:border-gray-700 p-8 mb-6">
      <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2"><%= t('sales_inquiries.new.get_in_touch_with_our_sales_team') %></h2>
      <p class="text-gray-600 dark:text-gray-400 mb-6"><%= t('sales_inquiries.new.fill_out_the_form_below_and_our_sales') %></p>

      <%= form_with url: talk_to_sales_path, method: :post, local: true, data: { turbo: false } do |f| %>
        <div class="grid md:grid-cols-2 gap-6">
          <div>
            <%= label_tag "inquiry[name]", t('apis_show.endpoint_documentation.column_name'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= text_field_tag "inquiry[name]", params.dig(:inquiry, :name),
              placeholder: t('auth.sign_up.name_placeholder'),
              class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-100 dark:placeholder-gray-500",
              required: true,
              autofocus: true %>
          </div>

          <div>
            <%= label_tag "inquiry[email]", t('home.contact.form.email'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
            <%= email_field_tag "inquiry[email]", params.dig(:inquiry, :email),
              placeholder: "john@company.com",
              class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-100 dark:placeholder-gray-500",
              required: true %>
          </div>
        </div>

        <div class="mt-6">
          <%= label_tag "inquiry[company]", t('sales_inquiries.new.company'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= text_field_tag "inquiry[company]", params.dig(:inquiry, :company),
            placeholder: t('sales_inquiries.new.acme_corporation'),
            class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white dark:bg-gray-700 dark:text-gray-100 dark:placeholder-gray-500",
            required: true %>
        </div>

        <div class="mt-6">
          <%= label_tag "inquiry[message]", t('sales_inquiries.new.anything_specific_you_want_to_share'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
          <%= text_area_tag "inquiry[message]", params.dig(:inquiry, :message),
            placeholder: t('sales_inquiries.new.tell_us_about_your_api_needs_expected'),
            rows: 5,
            class: "w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-transparent resize-none bg-white dark:bg-gray-700 dark:text-gray-100 dark:placeholder-gray-500" %>
          <p class="mt-1 text-xs text-gray-500 dark:text-gray-400"><%= t('sales_inquiries.new.optional_share_any_details_that_will') %></p>
        </div>

        <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4 mt-6 mb-6">
          <div class="flex items-start">
            <svg class="h-5 w-5 text-blue-500 mr-3 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <p class="text-sm text-blue-800 dark:text-blue-300"><%= t('sales_inquiries.new.we_usually_reply_within_24_hours') %></p>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-4">
          <%= link_to t('sales_inquiries.new.cancel'), root_path, class: "px-6 py-3 text-gray-700 dark:text-gray-300 font-medium hover:text-gray-900 dark:hover:text-gray-100 transition-colors" %>
          <%= submit_tag t('shared.nav.get_started'),
            class: "px-8 py-3 bg-indigo-600 text-white font-semibold rounded-xl hover:bg-indigo-700 transition-colors shadow-sm hover:shadow-md",
            data: { disable_with: t('sales_inquiries.new.sending') } %>
        </div>
      <% end %>
    </div>

    <!-- Footer Info -->
    <div class="text-center text-gray-600 dark:text-gray-400 text-sm">
      <p class="mb-2">
        <svg class="inline h-4 w-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
        </svg>
        <%= t('sales_inquiries.new.secure_info_notice') %>
      </p>
      <p>
        <%= t('sales_inquiries.new.have_questions_html',
              faq_link: link_to(t('sales_inquiries.new.faq_link'), faq_path,
                                class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 underline"),
              contact_link: link_to(t('sales_inquiries.new.contact_support'), contact_path,
                                    class: "text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300 underline")) %>
      </p>
    </div>
  </div>
</div>
