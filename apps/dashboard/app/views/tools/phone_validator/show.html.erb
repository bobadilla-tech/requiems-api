<% content_for :title, t('tools.phone_validator.show.phone_validator_carrier_lookup_line') %>
<% content_for :description, t('tools.phone_validator.show.description') %>
<% content_for :head do %>
  <script type="application/ld+json"><%= software_application_json_ld(
    name: t("tools.catalog.#{@tool_id.tr('-', '_')}.name"),
    description: t("tools.catalog.#{@tool_id.tr('-', '_')}.description"),
    url: tool_path(@tool_id)
  ).html_safe %></script>
<% end %>

<%= render "partials/phone_validator/hero" %>
<%= render "partials/shared/logo_marquee",
      logos: [
        { file: "companies/bobadilla-tech.png",   alt: "Bobadilla Tech"   },
        { file: "companies/compile-strength.png", alt: "Compile Strength" },
        { file: "companies/flyver.jpeg",           alt: "Flyver"           },
        { file: "companies/korealexa.png",         alt: "Korealexa"        },
        { file: "companies/shareweave.jpeg",       alt: "Shareweave"       },
      ],
      label: "Trusted by teams at",
      speed: "34s" %>
<%= render "partials/phone_validator/what_it_does" %>
<%= render "partials/phone_validator/use_cases" %>
<%= render "partials/phone_validator/api_combinations" %>
<%= render "partials/phone_validator/faq" %>
<%= render "partials/phone_validator/cta" %>
