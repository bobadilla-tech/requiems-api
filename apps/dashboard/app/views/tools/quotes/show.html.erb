<% content_for :title, t('tools.quotes.show.random_quote_generator_free_quotes_api') %>
<% content_for :description, t('tools.quotes.show.description') %>
<% content_for :head do %>
  <script type="application/ld+json"><%= software_application_json_ld(
    name: t("tools.catalog.#{@tool_id.tr('-', '_')}.name"),
    description: t("tools.catalog.#{@tool_id.tr('-', '_')}.description"),
    url: tool_path(@tool_id)
  ).html_safe %></script>
<% end %>

<main class="min-h-screen bg-white dark:bg-gray-950">
  <%= render "partials/tools/quotes/hero" %>
  <%= render "partials/tools/quotes/what_it_does" %>
  <%= render "partials/tools/quotes/use_cases" %>
  <%= render "partials/tools/quotes/api_combinations" %>
  <%= render "partials/tools/quotes/faq" %>
  <%= render "partials/tools/quotes/cta" %>
</main>
