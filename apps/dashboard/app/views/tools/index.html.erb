<div class="min-h-screen flex bg-gray-50 dark:bg-gray-900">

  <%# Sidebar %>
  <aside class="hidden lg:block w-52 bg-white dark:bg-gray-800 border-r border-gray-200 dark:border-gray-700 shrink-0" aria-label="<%= t('tools.index.categories_nav_label') %>">
    <div class="sticky top-16 max-h-[calc(100vh-4rem)] overflow-y-auto p-4">
      <h3 class="text-xs font-semibold text-gray-900 dark:text-gray-100 uppercase tracking-wider mb-3 px-2">
        <%= t('tools.index.categories_label') %>
      </h3>
      <nav class="space-y-0.5">
        <% @categories.each do |cat| %>
          <a href="#tools-<%= cat[:key] %>" class="flex items-center px-2 py-2 text-sm font-medium rounded transition-colors text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700">
            <span class="mr-2 inline-flex items-center justify-center w-6 h-6 rounded-full shrink-0 <%= category_color_classes(cat[:icon_category]) %>">
              <%= category_icon_svg(cat[:icon_category], size: "w-3.5 h-3.5") %>
            </span>
            <span class="flex-1"><%= t("tools.index.categories.#{cat[:key]}") %></span>
          </a>
        <% end %>
      </nav>
    </div>
  </aside>

  <div class="flex-1 min-w-0">

    <%# Mobile nav %>
    <div class="lg:hidden sticky top-16 z-20 flex gap-2 overflow-x-auto px-4 py-3 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700" role="navigation" aria-label="<%= t('tools.index.categories_nav_label') %>">
      <% @categories.each do |cat| %>
        <a href="#tools-<%= cat[:key] %>" class="shrink-0 inline-flex items-center gap-1.5 whitespace-nowrap rounded-full px-3 py-1.5 text-xs font-medium bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300">
          <span class="inline-flex items-center justify-center w-4 h-4 rounded-full shrink-0 <%= category_color_classes(cat[:icon_category]) %>">
            <%= category_icon_svg(cat[:icon_category], size: "w-2.5 h-2.5") %>
          </span>
          <%= t("tools.index.categories.#{cat[:key]}") %>
        </a>
      <% end %>
    </div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

      <%# Hero %>
      <div class="text-center mb-10 max-w-2xl mx-auto">
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-gray-900 dark:text-gray-100 mb-3">
          <%= t('tools.index.title') %>
        </h1>
        <p class="text-base text-gray-600 dark:text-gray-400">
          <%= t('tools.index.subtitle') %>
        </p>
      </div>

      <%# Category sections %>
      <div class="space-y-12">
        <% @categories.each do |cat| %>
          <section id="tools-<%= cat[:key] %>" class="scroll-mt-20" aria-labelledby="cat-heading-<%= cat[:key] %>">
            <h2 class="flex items-center text-xl font-bold text-gray-900 dark:text-gray-100 pb-2 mb-4 border-b border-gray-200 dark:border-gray-700" id="cat-heading-<%= cat[:key] %>">
              <span class="mr-2 inline-flex items-center justify-center w-8 h-8 rounded-full shrink-0 <%= category_color_classes(cat[:icon_category]) %>">
                <%= category_icon_svg(cat[:icon_category], size: "w-4 h-4") %>
              </span>
              <%= t("tools.index.categories.#{cat[:key]}") %>
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <% cat[:tools].each do |tool| %>
                <%= link_to tool_path(tool[:id]),
                      class: "block bg-white dark:bg-gray-800 rounded-lg shadow-sm hover:shadow-md transition-shadow border border-gray-200 dark:border-gray-700 p-4 group" do %>
                  <div class="w-10 h-10 rounded-lg flex items-center justify-center mb-3 <%= tool[:icon_classes] %>">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <%= icon_svg.call(tool[:id]).html_safe %>
                    </svg>
                  </div>

                  <h3 class="text-sm font-semibold text-gray-900 dark:text-gray-100 mb-1 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    <%= tool[:name] %>
                  </h3>

                  <p class="text-xs text-gray-600 dark:text-gray-400 line-clamp-2 leading-relaxed mb-3">
                    <%= tool[:description] %>
                  </p>

                  <span class="inline-flex items-center gap-1 text-xs font-medium text-blue-600 dark:text-blue-400">
                    <%= t('tools.index.try_live') %>
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
                    </svg>
                  </span>
                <% end %>
              <% end %>
            </div>
          </section>
        <% end %>
      </div>

    </div>

  </div>

</div>
