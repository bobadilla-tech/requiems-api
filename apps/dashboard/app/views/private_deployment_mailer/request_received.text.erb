<%= t("dashboard.mailers.private_deployments.request_received.subject") %>

<%= t("dashboard.mailers.private_deployments.request_received.greeting", name: @deployment_request.contact_name) %>

<%= t("dashboard.mailers.private_deployments.request_received.intro", company: @deployment_request.company) %>

<%= t("dashboard.mailers.private_deployments.request_received.order_summary").upcase %>
  <%= t("dashboard.mailers.private_deployments.request_received.server_tier") %>:       <%= @deployment_request.server_tier.capitalize %>
  <%= t("dashboard.mailers.private_deployments.request_received.monthly_price") %>:     $<%= "%.0f" % @deployment_request.monthly_price_dollars %>/mo
  <%= t("dashboard.mailers.private_deployments.request_received.selected_services") %>: <%= @deployment_request.selected_services.join(", ") %>

<%= t("dashboard.mailers.private_deployments.request_received.what_next") %>
<%= t("dashboard.mailers.private_deployments.request_received.what_next_detail") %>

<%= t("dashboard.mailers.private_deployments.request_received.docs_notice_html", docs_link: @docs_url).gsub(/<[^>]+>/, "") %>

