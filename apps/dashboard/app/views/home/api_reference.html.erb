<% content_for :title, t('home.api_reference.api_reference_requiems_api') %>
<% content_for :description, "Complete API reference documentation for all Requiems API endpoints. Authentication, rate limits, request formats, and response schemas." %>
<% content_for :head do %>
  <script type="application/ld+json"><%= article_json_ld(
    headline: t('home.api_reference.api_reference_requiems_api'),
    description: "Complete API reference documentation for all Requiems API endpoints. Authentication, rate limits, request formats, and response schemas.",
    url: api_reference_path
  ).html_safe %></script>
<% end %>

<div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 md:p-12">
      <h1 class="text-4xl font-bold text-gray-900 dark:text-gray-100 mb-6"><%= t('home.api_reference.api_reference') %></h1>

      <p class="text-xl text-gray-600 dark:text-gray-400 mb-12"><%= t('home.api_reference.complete_reference_documentation_for') %></p>



      <!-- Base URL -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">Base URL</h2>
        <div class="bg-gray-900 text-white p-4 rounded-lg font-mono text-sm">
          https://api.requiems.xyz
        </div>
      </div>

      <!-- Authentication -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4"><%= t('home.faq.authentication.heading') %></h2>
        <p class="text-gray-700 dark:text-gray-300 mb-4"><%= t('home.api_reference.all_api_requests_require_authentication') %></p>


        <div class="bg-gray-900 text-white p-4 rounded-lg font-mono text-sm">
          requiems-api-key: YOUR_API_KEY
        </div>
        <p class="text-gray-600 dark:text-gray-400 text-sm mt-2">
          <%= link_to t('home.api_reference.get_your_api_key'), user_signed_in? ? dashboard_api_keys_path : new_user_registration_path, class: "text-blue-600 hover:text-blue-700" %>
        </p>
      </div>

      <!-- Available APIs -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6"><%= t('home.api_reference.available_apis') %></h2>

        <div class="space-y-6">
          <!-- Email APIs -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= t('home.api_reference.email_apis') %></h3>
              <%= render "partials/shared/badge", text: t('home.api_reference.live'), variant: "success", size: "sm" %>
            </div>
            <p class="text-gray-700 dark:text-gray-300 mb-4"><%= t('home.api_reference.validate_email_addresses_detect') %></p>


            <%= link_to t('home.api_reference.view_email_api_documentation'), apis_path(category: "email"), class: "text-blue-600 hover:text-blue-700 font-medium inline-flex items-center" %>
            <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>

          <!-- Text APIs -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= t('home.api_reference.text_apis') %></h3>
              <%= render "partials/shared/badge", text: t('home.api_reference.live'), variant: "success", size: "sm" %>
            </div>
            <p class="text-gray-700 dark:text-gray-300 mb-4"><%= t('home.api_reference.generate_random_advice_quotes_lorem') %></p>


            <%= link_to t('home.api_reference.view_text_api_documentation'), apis_path(category: "text"), class: "text-blue-600 hover:text-blue-700 font-medium inline-flex items-center" %>
            <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>

          <!-- Miscellaneous APIs -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= t('home.api_reference.miscellaneous_apis') %></h3>
              <%= render "partials/shared/badge", text: t('home.api_reference.live'), variant: "success", size: "sm" %>
            </div>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              <%= t('home.api_reference.miscellaneous_apis_description') %>
            </p>
            <%= link_to t('home.api_reference.view_miscellaneous_api_documentation'), apis_path(category: "misc"), class: "text-blue-600 hover:text-blue-700 font-medium inline-flex items-center" %>
            <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </div>

          <!-- Coming Soon -->
          <div class="border border-gray-200 dark:border-gray-700 rounded-lg p-6 opacity-60">
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= t('home.api_reference.more_apis_coming_soon') %></h3>
              <%= render "partials/shared/badge", text: t('home.api_reference.roadmap'), variant: "secondary", size: "sm" %>
            </div>
            <p class="text-gray-700 dark:text-gray-300"><%= t('home.api_reference.data_apis_finance_apis_image_apis_and') %></p>


          </div>
        </div>
      </div>

      <!-- Rate Limits -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4"><%= t('home.faq.rate_limits.heading') %></h2>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
            <thead class="bg-gray-50 dark:bg-gray-700">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"><%= t('dashboard.billing.history.plan_label') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"><%= t('home.api_reference.requests_month') %></th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase"><%= t('dashboard.billing.usage.rate_limit_heading') %></th>
              </tr>
            </thead>
            <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('dashboard.plans.free') %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">500</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">30/minute</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('dashboard.plans.developer') %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">100,000</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">5,000/minute</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('dashboard.plans.business') %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">1,000,000</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">10,000/minute</td>
              </tr>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('dashboard.plans.professional') %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">10,000,000</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-700 dark:text-gray-300">50,000/minute</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="text-gray-600 dark:text-gray-400 text-sm mt-4">
          <%= link_to t('home.api_reference.view_pricing_details'), pricing_path, class: "text-blue-600 hover:text-blue-700" %>
        </p>
      </div>

      <!-- Error Codes -->
      <div class="mb-12">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4">HTTP Status Codes</h2>
        <div class="space-y-3">
          <div class="flex items-start">
            <span class="inline-block px-3 py-1 bg-green-100 dark:bg-green-900/20 text-green-800 dark:text-green-300 rounded text-sm font-mono mr-3">200</span>
            <div>
              <strong class="text-gray-900 dark:text-gray-100">OK</strong> <span class="text-gray-700 dark:text-gray-300">- Request succeeded</span>
            </div>
          </div>
          <div class="flex items-start">
            <span class="inline-block px-3 py-1 bg-yellow-100 dark:bg-yellow-900/20 text-yellow-800 dark:text-yellow-300 rounded text-sm font-mono mr-3">400</span>
            <div>
              <strong class="text-gray-900 dark:text-gray-100"><%= t('home.api_reference.bad_request') %></strong> <span class="text-gray-700 dark:text-gray-300">- Invalid request parameters</span>
            </div>
          </div>
          <div class="flex items-start">
            <span class="inline-block px-3 py-1 bg-red-100 dark:bg-red-900/20 text-red-800 dark:text-red-300 rounded text-sm font-mono mr-3">401</span>
            <div>
              <strong class="text-gray-900 dark:text-gray-100"><%= t('home.api_reference.unauthorized') %></strong> <span class="text-gray-700 dark:text-gray-300">- Missing or invalid API key</span>
            </div>
          </div>
          <div class="flex items-start">
            <span class="inline-block px-3 py-1 bg-red-100 dark:bg-red-900/20 text-red-800 dark:text-red-300 rounded text-sm font-mono mr-3">429</span>
            <div>
              <strong class="text-gray-900 dark:text-gray-100"><%= t('home.api_reference.too_many_requests') %></strong> <span class="text-gray-700 dark:text-gray-300">- Rate limit exceeded</span>
            </div>
          </div>
          <div class="flex items-start">
            <span class="inline-block px-3 py-1 bg-red-100 dark:bg-red-900/20 text-red-800 dark:text-red-300 rounded text-sm font-mono mr-3">500</span>
            <div>
              <strong class="text-gray-900 dark:text-gray-100"><%= t('home.api_reference.internal_server_error') %></strong> <span class="text-gray-700 dark:text-gray-300">- Something went wrong on our end</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
