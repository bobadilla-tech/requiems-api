<% content_for :title, t('admin.abuse_reports.index.abuse_reports') %>

<!-- Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= t('admin.abuse_reports.index.abuse_reports') %></h1>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400"><%= t('admin.abuse_reports.index.monitor_and_manage_abuse_reports') %></p>
</div>

<!-- Statistics Cards -->
<div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1"><%= t('admin.abuse_reports.index.total_reports') %></p>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= number_with_delimiter(@total_reports) %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1"><%= t('admin.private_deployments.index.pending') %></p>
    <p class="text-3xl font-bold text-orange-600"><%= number_with_delimiter(@pending_reports) %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1"><%= t('admin.abuse_reports.index.investigating') %></p>
    <p class="text-3xl font-bold text-blue-600"><%= number_with_delimiter(@investigating_reports) %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider mb-1"><%= t('admin.abuse_reports.index.resolved') %></p>
    <p class="text-3xl font-bold text-green-600"><%= number_with_delimiter(@resolved_reports) %></p>
  </div>
</div>

<!-- Search and Filters -->
<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6 mb-8">
  <%= form_with url: admin_abuse_reports_path, method: :get, local: true, class: "space-y-4" do |f| %>
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
      <!-- Search -->
      <div class="md:col-span-2">
        <%= f.label :search, t('admin.api_keys.index.search'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.text_field :search,
          value: params[:search],
          placeholder: t('admin.abuse_reports.index.search_by_user_email_or_description'),
          class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <!-- Status Filter -->
      <div>
        <%= f.label :status, t('shared.labels.col_status'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.select :status,
          options_for_select(
            [
              [t('admin.abuse_reports.index.all_statuses'), "all"],
              [t('admin.private_deployments.index.pending'), "pending"],
              [t('admin.abuse_reports.index.investigating'), "investigating"],
              [t('admin.abuse_reports.index.resolved'), "resolved"]
            ],
            params[:status] || "all"
          ),
          {},
          class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>

      <!-- Type Filter -->
      <div>
        <%= f.label :report_type, t('apis_show.endpoint_documentation.column_type'), class: "block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2" %>
        <%= f.select :report_type,
          options_for_select(
            [
              [t('admin.abuse_reports.index.all_types'), "all"],
              [t('admin.abuse_reports.index.spam'), "spam"],
              [t('admin.abuse_reports.index.abuse'), "abuse"],
              [t('admin.abuse_reports.index.malicious_activity'), "malicious"],
              [t('admin.abuse_reports.index.terms_violation'), "terms_violation"],
              [t('home.contact.form.inquiry_other'), "other"]
            ],
            params[:report_type] || "all"
          ),
          {},
          class: "w-full px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      </div>
    </div>

    <div class="flex items-center justify-between">
      <div class="flex items-center space-x-2">
        <%= f.submit t('admin.abuse_reports.index.apply_filters'), class: "px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors" %>
        <%= link_to t('admin.api_keys.index.clear'), admin_abuse_reports_path, class: "px-6 py-2 border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-medium rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors" %>
      </div>
    </div>
  <% end %>
</div>

<!-- Abuse Reports Table -->
<div class="bg-white dark:bg-gray-800 rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700 flex items-center justify-between">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
      Reports (<%= @pagy.count %>)
    </h2>
  </div>

  <% if @abuse_reports.any? %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('dashboard.referrals.table.user_col') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('apis_show.endpoint_documentation.column_type') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('apis_show.endpoint_documentation.column_description') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('admin.abuse_reports.index.reported') %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('shared.labels.col_status') %></th>
            <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('dashboard.api_keys.col_actions') %></th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @abuse_reports.each do |report| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="flex items-center">
                  <img src="<%= gravatar_url(report.user.email, size: 32) %>" alt="Avatar" class="flex-shrink-0 h-8 w-8 rounded-full">
                  <div class="ml-3">
                    <div class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= report.user.email %></div>
                  </div>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%
                  type_variant = case report.report_type
                    when "spam" then "warning"
                    when "abuse", "malicious" then "danger"
                    when "terms_violation" then "warning"
                    else "default"
                  end
                %>
                <%= render "partials/shared/badge", text: (report.report_type || "Unknown").titleize, variant: type_variant, size: "xs" %>
              </td>
              <td class="px-6 py-4 max-w-xs truncate text-sm text-gray-600 dark:text-gray-400">
                <%= report.description.present? ? truncate(report.description, length: 60) : "—" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-600 dark:text-gray-400">
                <%= time_ago_in_words(report.created_at) %> ago
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <%
                  status_variant = case report.status
                    when "pending" then "warning"
                    when "investigating" then "primary"
                    when "resolved" then "success"
                    else "default"
                  end
                %>
                <%= render "partials/shared/badge", text: (report.status || "Pending").titleize, variant: status_variant, size: "xs" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <%= link_to t('admin.abuse_reports.index.view'), admin_abuse_report_path(report), class: "text-blue-600 hover:text-blue-700" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <div class="px-6 py-4 border-t border-gray-200 dark:border-gray-700">
      <%== @pagy.series_nav if @pagy.pages > 1 %>
    </div>
  <% else %>
    <div class="px-6 py-12 text-center">
      <svg class="mx-auto h-12 w-12 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <h3 class="mt-2 text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('admin.abuse_reports.index.no_reports_found') %></h3>
      <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
        <% if params[:search].present? || params[:status].present? || params[:report_type].present? %>
          Try adjusting your search or filters.
        <% else %>
          All clear! No abuse reports have been submitted.
        <% end %>
      </p>
    </div>
  <% end %>
</div>
