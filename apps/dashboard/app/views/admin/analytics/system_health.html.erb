<% content_for :title, t('admin.analytics.system_health.system_health') %>

<%= render "partials/admin_analytics/nav" %>

<!-- Header -->
<div class="mb-8">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.system_health') %></h1>
      <p class="mt-2 text-sm text-gray-600 dark:text-gray-400"><%= t('admin.analytics.system_health.api_performance_and_reliability_metrics') %></p>
    </div>

    <!-- Time Range Selector -->
    <div class="flex items-center space-x-2">
      <%= form_with url: admin_analytics_system_health_path, method: :get, local: true, class: "flex items-center space-x-2" do |f| %>
        <%= f.select :time_range,
          options_for_select(
            [
              [t('admin.analytics.system_health.last_hour'), "1h"],
              [t('admin.analytics.system_health.last_24_hours'), "24h"],
              [t('admin.analytics.usage.last_7_days'), "7d"],
              [t('admin.analytics.usage.last_30_days'), "30d"]
            ],
            @time_range
          ),
          {},
          onchange: "this.form.submit()",
          class: "px-4 py-2 border border-gray-300 dark:border-gray-600 dark:bg-gray-700 dark:text-gray-100 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent" %>
      <% end %>
    </div>
  </div>
</div>

<!-- Health Status Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
  <!-- API Uptime -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('admin.analytics.system_health.api_uptime') %></h3>
      <div class="p-2 <%= @uptime_percentage >= 99 ? 'bg-green-100 dark:bg-green-900/30' : 'bg-red-100 dark:bg-red-900/30' %> rounded-lg">
        <svg class="h-6 w-6 <%= @uptime_percentage >= 99 ? 'text-green-600' : 'text-red-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <p class="text-3xl font-bold <%= @uptime_percentage >= 99 ? 'text-green-600' : 'text-red-600' %>"><%= @uptime_percentage %>%</p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
      <%= @uptime_percentage >= 99.9 ? t('admin.analytics.system_health.status_excellent') : (@uptime_percentage >= 99 ? t('admin.analytics.system_health.status_good') : t('admin.analytics.system_health.status_needs_attention')) %>
    </p>
  </div>

  <!-- P50 Response Time -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('admin.analytics.system_health.p50_response_time') %></h3>
      <div class="p-2 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
        <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @p50_response_time %><span class="text-xl">ms</span></p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.median_response_time') %></p>
  </div>

  <!-- P95 Response Time -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('admin.analytics.system_health.p95_response_time') %></h3>
      <div class="p-2 bg-orange-100 dark:bg-orange-900/30 rounded-lg">
        <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @p95_response_time %><span class="text-xl">ms</span></p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.95th_percentile') %></p>
  </div>

  <!-- P99 Response Time -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('admin.analytics.system_health.p99_response_time') %></h3>
      <div class="p-2 bg-red-100 dark:bg-red-900/30 rounded-lg">
        <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
      </div>
    </div>
    <p class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= @p99_response_time %><span class="text-xl">ms</span></p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.99th_percentile') %></p>
  </div>
</div>

<!-- Error Rate Trend -->
<div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.error_rate_over_time') %></h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.percentage_of_requests_resulting_in') %></p>
  </div>
  <div class="p-6">
    <%= line_chart @error_rate_trend,
      suffix: "%",
      height: "300px",
      colors: ["#ef4444"],
      library: {
        scales: {
          y: {
            beginAtZero: true,
            max: 100
          }
        }
      } %>
  </div>
</div>

<!-- Real-time Monitoring (Last Hour) -->
<% if @time_range == "1h" && @requests_per_minute.present? %>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.requests_per_minute_last_hour') %></h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.real_time_traffic_monitoring') %></p>
    </div>
    <div class="p-6">
      <%= line_chart @requests_per_minute,
        height: "250px",
        colors: ["#3b82f6"],
        library: {
          scales: {
            y: { beginAtZero: true }
          }
        } %>
    </div>
  </div>
<% end %>

<!-- Error Analysis -->
<div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
  <!-- Common Errors -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.most_common_errors') %></h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.top_10_error_status_codes') %></p>
    </div>
    <% if @common_errors.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('admin.analytics.system_health.status_code') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('apis_show.endpoint_documentation.column_description') %></th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider"><%= t('admin.analytics.system_health.count') %></th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
            <% @common_errors.each do |status_code, count| %>
              <%
                status_descriptions = {
                  400 => "Bad Request",
                  401 => "Unauthorized",
                  403 => "Forbidden",
                  404 => "Not Found",
                  429 => "Too Many Requests",
                  500 => "Internal Server Error",
                  502 => "Bad Gateway",
                  503 => "Service Unavailable",
                  504 => "Gateway Timeout"
                }
              %>
              <tr class="hover:bg-gray-50 dark:hover:bg-gray-700">
                <td class="px-6 py-4 whitespace-nowrap">
                  <%
                    status_variant = case status_code
                      when 400..499 then "warning"
                      when 500..599 then "danger"
                      else "default"
                    end
                  %>
                  <%= render "partials/shared/badge", text: status_code.to_s, variant: status_variant, size: "sm" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900 dark:text-gray-100">
                  <%= status_descriptions[status_code] || "Unknown" %>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900 dark:text-gray-100">
                  <%= number_with_delimiter(count) %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="px-6 py-12 text-center">
        <svg class="mx-auto h-12 w-12 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        <p class="mt-2 text-sm font-medium text-green-600"><%= t('admin.analytics.system_health.no_errors_recorded') %></p>
        <p class="text-sm text-gray-500 dark:text-gray-400"><%= t('admin.analytics.system_health.the_system_is_running_perfectly') %></p>
      </div>
    <% end %>
  </div>

  <!-- Security Metrics -->
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow">
    <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
      <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.security_metrics') %></h2>
      <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t('admin.analytics.system_health.authentication_and_security_events') %></p>
    </div>
    <div class="p-6 space-y-6">
      <!-- Failed Authentication Attempts -->
      <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
        <div class="flex items-center">
          <div class="p-3 <%= @failed_auth_attempts > 100 ? 'bg-red-100 dark:bg-red-900/30' : 'bg-green-100 dark:bg-green-900/30' %> rounded-lg">
            <svg class="h-6 w-6 <%= @failed_auth_attempts > 100 ? 'text-red-600' : 'text-green-600' %>" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t('admin.analytics.system_health.failed_auth_attempts_24h') %></p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= number_with_delimiter(@failed_auth_attempts) %></p>
          </div>
        </div>
        <% if @failed_auth_attempts > 100 %>
          <%= render "partials/shared/badge", text: t('admin.analytics.system_health.high'), variant: "danger", size: "sm" %>
        <% else %>
          <%= render "partials/shared/badge", text: t('admin.analytics.system_health.normal'), variant: "success", size: "sm" %>
        <% end %>
      </div>

      <!-- Rate Limit Hits -->
      <div class="flex items-center justify-between p-4 bg-gray-50 dark:bg-gray-700 rounded-lg">
        <div class="flex items-center">
          <div class="p-3 bg-blue-100 dark:bg-blue-900/30 rounded-lg">
            <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
            </svg>
          </div>
          <div class="ml-4">
            <p class="text-sm font-medium text-gray-500 dark:text-gray-400">Rate Limit Hits (24h)</p>
            <p class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= number_with_delimiter(@rate_limit_hits) %></p>
          </div>
        </div>
        <%= render "partials/shared/badge", text: t('comparisons.hub.card_coming_soon'), variant: "default", size: "sm" %>
      </div>

      <!-- Security Notice -->
      <div class="p-4 bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-lg">
        <div class="flex">
          <svg class="h-5 w-5 text-blue-600 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          <div class="ml-3">
            <h3 class="text-sm font-medium text-blue-800 dark:text-blue-300"><%= t('admin.analytics.system_health.security_monitoring') %></h3>
            <p class="mt-1 text-sm text-blue-700 dark:text-blue-400">
              <%= t('admin.analytics.system_health.security_monitoring_body') %>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Health Insights -->
<div class="bg-white dark:bg-gray-800 rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.system_health_insights') %></h2>
  </div>
  <div class="p-6">
    <div class="space-y-4">
      <!-- Uptime Status -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <% if @uptime_percentage >= 99.9 %>
            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% elsif @uptime_percentage >= 99 %>
            <svg class="h-6 w-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% else %>
            <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% end %>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.api_uptime') %></h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            <% if @uptime_percentage >= 99.9 %>
              <strong class="text-green-600"><%= t('admin.analytics.system_health.uptime_excellent_label') %></strong>
              <%= t('admin.analytics.system_health.uptime_excellent_description') %>
            <% elsif @uptime_percentage >= 99 %>
              <strong class="text-blue-600"><%= t('admin.analytics.system_health.uptime_good_label') %></strong>
              <%= t('admin.analytics.system_health.uptime_good_description') %>
            <% else %>
              <strong class="text-red-600"><%= t('admin.analytics.system_health.uptime_low_label') %></strong>
              <%= t('admin.analytics.system_health.uptime_low_description') %>
            <% end %>
          </p>
        </div>
      </div>

      <!-- Response Time Status -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <% if @p95_response_time < 500 %>
            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
            </svg>
          <% elsif @p95_response_time < 1000 %>
            <svg class="h-6 w-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% else %>
            <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          <% end %>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.response_times') %></h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            <% if @p95_response_time < 500 %>
              <strong class="text-green-600"><%= t('admin.analytics.system_health.response_fast_label') %></strong>
              <%= t('admin.analytics.system_health.response_fast_description') %>
            <% elsif @p95_response_time < 1000 %>
              <strong class="text-orange-600"><%= t('admin.analytics.system_health.response_acceptable_label') %></strong>
              <%= t('admin.analytics.system_health.response_acceptable_description') %>
            <% else %>
              <strong class="text-red-600"><%= t('admin.analytics.system_health.response_slow_label') %></strong>
              <%= t('admin.analytics.system_health.response_slow_description') %>
            <% end %>
            <%= t('admin.analytics.system_health.response_times_detail', p95: @p95_response_time, p99: @p99_response_time) %>
          </p>
        </div>
      </div>

      <!-- Security Status -->
      <div class="flex items-start">
        <div class="flex-shrink-0">
          <% if @failed_auth_attempts > 100 %>
            <svg class="h-6 w-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
            </svg>
          <% else %>
            <svg class="h-6 w-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
            </svg>
          <% end %>
        </div>
        <div class="ml-3">
          <h3 class="text-sm font-medium text-gray-900 dark:text-gray-100"><%= t('admin.analytics.system_health.security_label') %></h3>
          <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">
            <% if @failed_auth_attempts > 100 %>
              <strong class="text-red-600"><%= t('admin.analytics.system_health.security_high_label') %></strong>
              <%= t('admin.analytics.system_health.security_high_description') %>
            <% else %>
              <strong class="text-green-600"><%= t('admin.analytics.system_health.security_normal_label') %></strong>
              <%= t('admin.analytics.system_health.security_normal_description') %>
            <% end %>
            <%= t('admin.analytics.system_health.failed_auth_attempts_detail', count: number_with_delimiter(@failed_auth_attempts)) %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>
