<% content_for :title, t("dashboard.referrals.title") %>

<!-- Header -->
<div class="mb-8">
  <h1 class="text-3xl font-bold text-gray-900 dark:text-gray-100"><%= t("dashboard.referrals.title") %></h1>
  <p class="mt-2 text-sm text-gray-600 dark:text-gray-400"><%= t("dashboard.referrals.subtitle") %></p>
</div>

<!-- Stats Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("dashboard.referrals.stats.total_referred") %></p>
    <p class="mt-2 text-4xl font-bold text-gray-900 dark:text-gray-100"><%= @total_referred %></p>
  </div>
  <div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6">
    <p class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("dashboard.referrals.stats.total_converted") %></p>
    <p class="mt-2 text-4xl font-bold text-indigo-600 dark:text-indigo-400"><%= @total_converted %></p>
  </div>
</div>

<!-- Referral Link -->
<div class="bg-white dark:bg-gray-800 rounded-lg shadow mb-8">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t("dashboard.referrals.link.heading") %></h2>
    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><%= t("dashboard.referrals.link.description") %></p>
  </div>
  <div class="p-6">
    <div class="flex items-center gap-3">
      <input
        id="referral-link"
        type="text"
        value="<%= @referral_link %>"
        readonly
        class="flex-1 rounded-md border border-gray-300 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 px-3 py-2 text-sm text-gray-900 dark:text-gray-100 font-mono"
      />
      <button
        type="button"
        onclick="navigator.clipboard.writeText(document.getElementById('referral-link').value).then(() => { this.textContent = '<%= t("dashboard.referrals.link.copied") %>'; setTimeout(() => { this.textContent = '<%= t("dashboard.referrals.link.copy") %>'; }, 2000); })"
        class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-700 focus:outline-none"
      >
        <%= t("dashboard.referrals.link.copy") %>
      </button>
    </div>
  </div>
</div>

<!-- Recent Referrals Table -->
<div class="bg-white dark:bg-gray-800 rounded-lg shadow">
  <div class="px-6 py-4 border-b border-gray-200 dark:border-gray-700">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-gray-100"><%= t("dashboard.referrals.table.heading") %></h2>
  </div>
  <% if @recent_referrals.empty? %>
    <div class="p-6 text-center text-sm text-gray-500 dark:text-gray-400">
      <%= t("dashboard.referrals.table.empty") %>
    </div>
  <% else %>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
        <thead class="bg-gray-50 dark:bg-gray-700">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><%= t("dashboard.referrals.table.user_col") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><%= t("dashboard.referrals.table.date_col") %></th>
            <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider"><%= t("dashboard.referrals.table.status_col") %></th>
          </tr>
        </thead>
        <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700">
          <% @recent_referrals.each do |referral| %>
            <tr>
              <td class="px-6 py-4 text-sm text-gray-900 dark:text-gray-100">
                <%= referral.referred_user.display_name %>
              </td>
              <td class="px-6 py-4 text-sm text-gray-500 dark:text-gray-400">
                <%= referral.created_at.strftime("%b %d, %Y") %>
              </td>
              <td class="px-6 py-4 text-sm">
                <% if referral.converted? %>
                  <span class="inline-flex items-center rounded-full bg-green-100 dark:bg-green-900/30 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:text-green-400">
                    <%= t("dashboard.referrals.table.status_converted") %>
                  </span>
                <% else %>
                  <span class="inline-flex items-center rounded-full bg-yellow-100 dark:bg-yellow-900/30 px-2.5 py-0.5 text-xs font-medium text-yellow-800 dark:text-yellow-400">
                    <%= t("dashboard.referrals.table.status_pending") %>
                  </span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
