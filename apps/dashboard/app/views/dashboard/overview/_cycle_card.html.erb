<%# locals: (usage:, has_keys:) %>
<div class="bg-white dark:bg-gray-800 rounded-lg shadow p-6" id="cycle-card">
  <div class="flex items-center justify-between mb-4">
    <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400"><%= t("dashboard.overview.usage.resets_heading") %></h3>
    <div class="p-2 bg-green-100 dark:bg-green-900 rounded-lg">
      <svg class="h-6 w-6 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
      </svg>
    </div>
  </div>

  <% if usage.anchored? %>
    <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 leading-tight" data-testid="resets-on"><%= usage_resets_on(usage) %></p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1"><%= t("dashboard.overview.usage.resets_in", count: usage_resets_in_days(usage)) %></p>
  <% else %>
    <p class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 leading-tight">—</p>
    <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
      <% if has_keys %>
        <%= t("dashboard.overview.usage.no_cycle") %>
      <% else %>
        <%= link_to t("dashboard.overview.usage.create_key_first"), new_dashboard_api_key_path, class: "text-blue-600 dark:text-blue-400 hover:underline" %>
      <% end %>
    </p>
  <% end %>

  <p class="text-sm text-gray-700 dark:text-gray-300 mt-3" data-testid="last-request"><%= usage_last_request_text(usage) %></p>
  <p class="text-xs text-gray-600 dark:text-gray-400 mt-2"><%= t("dashboard.overview.usage.ledger_help") %></p>
</div>
