<% content_for :title, t("blog.hub.meta_title") %>
<% content_for :description, t("blog.hub.meta_description") %>
<% content_for :head do %>
  <script type="application/ld+json"><%= collection_json_ld(
    name: "Blog",
    items: BlogPost.all.map { |post| { name: post.title, url: blog_post_path(post.slug) } }
  ).html_safe %></script>
<% end %>

<section class="bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 text-white py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4"><%= t("blog.hub.hero_headline") %></h1>
    <p class="text-lg sm:text-xl text-blue-100 max-w-2xl mx-auto leading-relaxed">
      <%= t("blog.hub.hero_subheadline") %>
    </p>
  </div>
</section>

<section class="py-14 bg-gray-50 dark:bg-gray-950">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    <% if @posts.empty? %>
      <p class="text-center text-gray-500 dark:text-gray-400"><%= t("blog.hub.empty_state") %></p>
    <% else %>
      <div class="space-y-6">
        <% @posts.each do |post| %>
          <%= link_to blog_post_path(post.slug),
                      class: "group block rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-8 shadow-sm hover:shadow-md hover:border-blue-300 dark:hover:border-blue-600 transition-all" do %>
            <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400 mb-3">
              <time datetime="<%= post.date.iso8601 %>"><%= post.date.strftime("%B %-d, %Y") %></time>
              <span aria-hidden="true">&middot;</span>
              <span><%= t("blog.hub.reading_time", minutes: post.reading_time_minutes) %></span>
            </div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3 group-hover:text-blue-600 dark:group-hover:text-blue-400">
              <%= post.title %>
            </h2>
            <p class="text-gray-600 dark:text-gray-300 leading-relaxed mb-4"><%= post.description %></p>
            <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 inline-flex items-center">
              <%= t("blog.hub.read_post") %>
              <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
