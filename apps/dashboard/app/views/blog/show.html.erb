<% content_for :title, "#{@post.title} - Requiems API Blog" %>
<% content_for :description, @post.description %>
<% content_for :head do %>
  <%= render "partials/shared/highlight_head" %>
  <script type="application/ld+json"><%= blog_post_json_ld(@post).html_safe %></script>
<% end %>

<article class="py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <p class="mb-6">
      <%= link_to t("blog.show.back_to_blog"), blog_path, class: "text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline" %>
    </p>

    <header class="mb-10">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight text-gray-900 dark:text-gray-100 mb-4">
        <%= @post.title %>
      </h1>
      <div class="flex items-center gap-3 text-sm text-gray-500 dark:text-gray-400">
        <span><%= @post.author %></span>
        <span aria-hidden="true">&middot;</span>
        <time datetime="<%= @post.date.iso8601 %>"><%= @post.date.strftime("%B %-d, %Y") %></time>
        <span aria-hidden="true">&middot;</span>
        <span><%= t("blog.show.reading_time", minutes: @post.reading_time_minutes) %></span>
      </div>
    </header>

    <div class="blog-prose" data-controller="highlight">
      <%= @post.to_html.html_safe %>
    </div>
  </div>
</article>
