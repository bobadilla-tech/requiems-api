<%# locals: (i18n_scope:) %>
<% rows = case_study_api_rows(i18n_scope) %>
<% if rows.present? %>
<section class="py-14 bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2">
      <%= t("case_studies.common.apis_heading") %>
    </h2>
    <p class="text-gray-600 dark:text-gray-300 mb-8 max-w-2xl">
      <%= t("case_studies.common.apis_intro") %>
    </p>
    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 text-sm">
        <thead class="bg-gray-50 dark:bg-gray-800/80">
          <tr>
            <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-900 dark:text-gray-100"><%= t("case_studies.common.table_api") %></th>
            <th scope="col" class="px-4 py-3 text-left font-semibold text-gray-900 dark:text-gray-100"><%= t("case_studies.common.table_benefit") %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800 bg-white dark:bg-gray-900">
          <% rows.each do |row| %>
            <tr class="hover:bg-gray-50/80 dark:hover:bg-gray-800/50">
              <td class="px-4 py-3 font-medium text-blue-600 dark:text-blue-400 whitespace-nowrap">
                <%= link_to row[:name], api_path(row[:id]), class: "hover:underline" %>
              </td>
              <td class="px-4 py-3 text-gray-600 dark:text-gray-300">
                <%= row[:benefit] %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>
<% end %>
