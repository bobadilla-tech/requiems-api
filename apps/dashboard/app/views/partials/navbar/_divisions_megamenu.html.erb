<%# Desktop: primary label goes to hub; hover reveals panel with SVG icons (ApisHelper). %>
<div class="relative z-[100] group">
  <%= link_to divisions_path,
              class: "inline-flex items-center gap-1 rounded-lg px-2 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-50 dark:hover:bg-gray-800 hover:text-blue-600 dark:hover:text-blue-400 transition-colors",
              "aria-haspopup": "true" do %>
    <span><%= t("shared.nav.divisions") %></span>
    <svg class="h-4 w-4 text-gray-400 transition-transform duration-200 group-hover:rotate-180 dark:text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  <% end %>

  <div class="pointer-events-none absolute left-0 top-full pt-2 w-[min(calc(100vw-2rem),20rem)] opacity-0 transition duration-150 ease-out group-hover:pointer-events-auto group-hover:opacity-100 focus-within:pointer-events-auto focus-within:opacity-100 sm:w-80">
    <div class="pointer-events-auto rounded-xl border border-gray-200 bg-white py-2 shadow-xl ring-1 ring-black/5 dark:border-gray-700 dark:bg-gray-800 dark:ring-white/10">
      <p class="px-3 pb-1 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">
        <%= t("shared.nav.divisions_panel_heading") %>
      </p>
      <div class="max-h-[min(70vh,24rem)] overflow-y-auto px-1">
        <% DivisionSlugs::ALL.each do |slug| %>
          <%= link_to division_path(slug),
                      class: "group flex items-center gap-3 rounded-lg px-2 py-2 text-sm text-gray-800 hover:bg-gray-50 dark:text-gray-100 dark:hover:bg-gray-700/80" do %>
            <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg <%= category_color_classes(slug, hover: true) %>">
              <%= category_icon_svg(slug, size: "w-5 h-5") %>
            </span>
            <span class="min-w-0 font-medium leading-snug"><%= t("divisions.index.cards.#{slug}.title") %></span>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</div>
