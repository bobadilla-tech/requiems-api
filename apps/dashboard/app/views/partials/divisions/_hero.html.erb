<%# locals: (i18n_scope:) %>
<section class="bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 text-white py-16 sm:py-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
      <%= t("#{i18n_scope}.hero.headline") %>
    </h1>
    <p class="text-lg sm:text-xl text-blue-100 mb-8 max-w-2xl mx-auto leading-relaxed">
      <%= t("#{i18n_scope}.hero.subheadline") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center mb-6">
      <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold text-blue-900 bg-white hover:bg-blue-50 shadow-lg transition-colors" do %>
        <%= t("#{i18n_scope}.hero.primary_cta") %>
      <% end %>
      <%= link_to pricing_path, class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold border-2 border-white/80 text-white hover:bg-white/10 transition-colors" do %>
        <%= t("#{i18n_scope}.hero.secondary_cta") %>
      <% end %>
      <%= link_to cal_com_strategy_url, rel: "noopener noreferrer", target: "_blank", class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold border border-white/40 text-white hover:bg-white/10 transition-colors" do %>
        <%= t("#{i18n_scope}.strategy_call.label") %>
      <% end %>
    </div>
  </div>
</section>
