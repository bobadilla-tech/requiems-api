<%# locals: (i18n_scope:) %>
<% filters = division_locale_array(i18n_scope, "filters") %>
<section class="py-8 bg-gray-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800" aria-labelledby="division-filters-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 id="division-filters-heading" class="text-sm font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-4">
      <%= t("divisions.common.filters_heading") %>
    </h2>
    <div class="flex flex-wrap gap-2">
      <% filters.each do |f| %>
        <% key = f["key"] %>
        <% active = key == "all" %>
        <button type="button"
                data-division-hub-target="filterBtn"
                data-filter-key="<%= key %>"
                data-action="click->division-hub#setFilter"
                class="px-4 py-2 rounded-full text-sm font-medium border transition-colors
                       <%= active ? 'bg-blue-600 text-white border-blue-600 dark:bg-blue-500' : 'border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:border-blue-400' %>">
          <%= f["label"] %>
        </button>
      <% end %>
    </div>
  </div>
</section>
