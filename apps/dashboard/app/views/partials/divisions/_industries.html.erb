<%# locals: (i18n_scope:) %>
<% rows = division_locale_array(i18n_scope, "industries") %>
<section class="py-12 bg-gray-50 dark:bg-gray-950 border-t border-slate-200/80 dark:border-slate-800" aria-labelledby="division-industries-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 id="division-industries-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-6 text-center">
      <%= t("divisions.common.industries_heading") %>
    </h2>
    <div class="flex flex-wrap justify-center gap-2">
      <% rows.each do |label| %>
        <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-white dark:bg-gray-900 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-200">
          <%= label %>
        </span>
      <% end %>
    </div>
  </div>
</section>
