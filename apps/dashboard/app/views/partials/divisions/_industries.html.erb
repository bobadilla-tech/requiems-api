<section class="py-14 bg-gray-50 dark:bg-gray-950 border-t border-slate-200/80 dark:border-slate-800" aria-labelledby="division-industries-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 id="division-industries-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100 mb-8 text-center">
      <%= t("divisions.common.industries_heading") %>
    </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      <% rows.each do |label| %>
        <div class="flex items-center gap-3 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 px-4 py-3 shadow-sm">
          <span class="flex-shrink-0 text-gray-500 dark:text-gray-400" aria-hidden="true">
            <%= (industry_icons[label] || fallback_icon).html_safe %>
          </span>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-200 leading-snug"><%= label %></span>
        </div>
      <% end %>
    </div>
  </div>
</section>
