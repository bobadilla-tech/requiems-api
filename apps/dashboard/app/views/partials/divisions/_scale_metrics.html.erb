<%# locals: (i18n_scope:) %>
<% metrics = division_locale_array(i18n_scope, "scale_metrics") %>
<section class="py-14 bg-white dark:bg-gray-900 border-y border-gray-100 dark:border-gray-800" aria-labelledby="division-scale-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 id="division-scale-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-10 text-center">
      <%= t("divisions.common.scale_heading") %>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
      <% metrics.each do |m| %>
        <div class="rounded-2xl bg-gray-50 dark:bg-gray-800/60 p-8 border border-gray-100 dark:border-gray-700">
          <p class="text-3xl sm:text-4xl font-extrabold text-blue-600 dark:text-blue-400 mb-2"><%= m["value"] %></p>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-snug"><%= m["label"] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
