<%# locals: (i18n_scope:) %>
<% cases = division_locale_array(i18n_scope, "use_cases") %>
<% seen_anchors = {} %>
<section class="py-14 bg-gray-50 dark:bg-gray-950" aria-labelledby="division-use-cases-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 id="division-use-cases-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-8">
      <%= t("divisions.common.use_cases_heading") %>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% cases.each_with_index do |uc, i| %>
        <% anchor = uc[:case_anchor].presence %>
        <% dom_id = nil %>
        <% if anchor && !seen_anchors.key?(anchor) %>
          <% seen_anchors[anchor] = true %>
          <% dom_id = anchor %>
        <% end %>
        <div data-division-hub-target="gridCard"
             data-filter-key="<%= uc[:filter_key] %>"
             <% if dom_id %>id="<%= dom_id %>"<% end %>
             class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm hover:shadow-md transition-shadow scroll-mt-24">
          <% ep = uc[:endpoint].presence %>
          <% if ep %>
            <p class="text-xs sm:text-sm font-mono font-semibold text-blue-600 dark:text-blue-400 mb-2 break-all leading-snug"><%= ep %></p>
          <% end %>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3 break-words"><%= uc[:title] %></h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-4 leading-relaxed"><%= uc[:description] %></p>
          <div class="flex flex-wrap gap-2">
            <span class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300"><%= uc[:tag_problem] %></span>
            <span class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300"><%= uc[:tag_industry] %></span>
          </div>
          <% if uc[:example].present? %>
            <div class="mt-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50/90 dark:bg-gray-800/50 px-4 py-3">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-2">
                <%= t("divisions.common.use_case_example_label") %>
              </p>
              <p class="text-sm text-gray-700 dark:text-gray-200 leading-relaxed"><%= uc[:example] %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
