<%# locals: (i18n_scope:, view_case_label:) %>
<% cases = division_locale_array(i18n_scope, "use_cases") %>
<% seen_anchors = {} %>
<section class="py-14 bg-gray-50 dark:bg-gray-950" aria-labelledby="division-use-cases-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 id="division-use-cases-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3">
      <%= t("divisions.common.use_cases_heading") %>
    </h2>
    <div class="rounded-xl border border-amber-200/80 dark:border-amber-900/50 bg-amber-50/90 dark:bg-amber-950/25 px-4 py-3 mb-8 text-sm text-amber-950 dark:text-amber-100/90 leading-relaxed">
      <span class="font-semibold text-amber-900 dark:text-amber-200"><%= t("divisions.common.use_cases_roadmap_label") %></span>
      <%= t("divisions.common.use_cases_roadmap_note") %>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% cases.each_with_index do |uc, i| %>
        <% anchor = uc["case_anchor"].presence %>
        <% dom_id = nil %>
        <% if anchor && !seen_anchors.key?(anchor) %>
          <% seen_anchors[anchor] = true %>
          <% dom_id = anchor %>
        <% end %>
        <div data-division-hub-target="gridCard"
             data-filter-key="<%= uc['filter_key'] %>"
             <% if dom_id %>id="<%= dom_id %>"<% end %>
             class="rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm hover:shadow-md transition-shadow scroll-mt-24">
          <p class="text-sm font-bold text-blue-600 dark:text-blue-400 mb-2"><%= uc["metric"] %></p>
          <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= uc["title"] %></h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 mb-4 leading-relaxed"><%= uc["description"] %></p>
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300"><%= uc["tag_problem"] %></span>
            <span class="text-xs px-2 py-1 rounded bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-300"><%= uc["tag_industry"] %></span>
          </div>
          <% if anchor %>
            <%= link_to "##{anchor}", class: "text-sm font-semibold text-blue-600 dark:text-blue-400 hover:underline inline-flex items-center" do %>
              <%= view_case_label %>
              <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
