<%# locals: (i18n_scope:) %>
<section class="py-20 bg-gradient-to-br from-blue-600 to-indigo-800">
  <div class="max-w-3xl mx-auto px-4 text-center text-white">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4"><%= t("#{i18n_scope}.final_cta.headline") %></h2>
    <p class="text-lg text-blue-100 mb-8"><%= t("#{i18n_scope}.final_cta.subheadline") %></p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold text-blue-900 bg-white hover:bg-blue-50 shadow-lg transition-colors" do %>
        <%= t("#{i18n_scope}.final_cta.primary_cta") %>
      <% end %>
      <%= link_to apis_path, class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold border-2 border-white/80 text-white hover:bg-white/10 transition-colors" do %>
        <%= t("#{i18n_scope}.final_cta.secondary_cta") %>
      <% end %>
    </div>
  </div>
</section>
