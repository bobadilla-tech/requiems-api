<%# locals: (i18n_scope:) %>
<% slides = division_locale_array(i18n_scope, "featured_cases") %>
<% unless slides.empty? %>
<section class="py-14 bg-slate-50 dark:bg-gray-950" aria-labelledby="division-carousel-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <header class="mb-10 text-center sm:mb-12 sm:text-left">
      <h2 id="division-carousel-heading" class="text-2xl font-bold tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">
        <%= t("divisions.carousel.heading") %>
      </h2>
      <p class="mt-3 max-w-2xl text-sm text-gray-600 dark:text-gray-400 sm:mx-0 sm:text-base">
        <%= t("divisions.carousel.subtitle") %>
      </p>
    </header>
    <div class="relative rounded-2xl border border-gray-200/90 bg-white p-5 shadow-md shadow-slate-900/[0.04] dark:border-gray-600 dark:bg-gray-800 dark:shadow-2xl dark:shadow-black/40 dark:ring-1 dark:ring-inset dark:ring-white/10 sm:p-8">
      <div class="min-h-0" data-division-hub-target="slideViewport">
        <% slides.each_with_index do |slide, i| %>
        <article data-division-hub-target="slide"
                 class="<%= i.zero? ? '' : 'hidden' %>"
                 aria-hidden="<%= i.zero? ? 'false' : 'true' %>">
          <div class="flex flex-wrap gap-2 mb-4">
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-200">
              <%= slide[:badge_featured] %>
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-semibold bg-gray-100 text-gray-800 dark:bg-gray-800 dark:text-gray-200">
              <%= slide[:badge_api] %>
            </span>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 mb-2"><%= slide[:company_line] %></p>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4"><%= slide[:title] %></h3>
          <p class="text-gray-600 dark:text-gray-300 mb-6 leading-relaxed"><%= slide[:body] %></p>
          <blockquote class="border-l-4 border-blue-500 pl-6 mb-8 text-gray-700 dark:text-gray-300 italic">
            <%= slide[:quote] %>
            <footer class="mt-3 not-italic text-sm text-gray-500 dark:text-gray-400 pl-1">— <%= slide[:quote_attribution] %></footer>
          </blockquote>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
            <div class="rounded-xl border border-red-200 dark:border-red-900/50 bg-red-50/80 dark:bg-red-950/30 p-4">
              <p class="text-xs font-semibold text-red-700 dark:text-red-300 uppercase tracking-wide"><%= slide[:metric_negative_label] %></p>
              <p class="text-xl font-bold text-red-800 dark:text-red-200"><%= slide[:metric_negative_value] %></p>
            </div>
            <div class="rounded-xl border border-emerald-200 dark:border-emerald-900/50 bg-emerald-50/80 dark:bg-emerald-950/30 p-4">
              <p class="text-xs font-semibold text-emerald-700 dark:text-emerald-300 uppercase tracking-wide"><%= slide[:metric_positive_label] %></p>
              <p class="text-xl font-bold text-emerald-800 dark:text-emerald-200"><%= slide[:metric_positive_value] %></p>
            </div>
            <div class="rounded-xl border border-gray-200 dark:border-gray-600 bg-gray-50 dark:bg-gray-700 p-4">
              <p class="text-xs font-semibold text-gray-600 dark:text-gray-200 uppercase tracking-wide"><%= slide[:metric_efficiency_label] %></p>
              <p class="text-xl font-bold text-gray-900 dark:text-gray-100"><%= slide[:metric_efficiency_value] %></p>
            </div>
          </div>
        </article>
        <% end %>
      </div>
      <% if slides.size > 1 %>
        <div class="flex items-center justify-between mt-8 gap-4">
          <button type="button" class="p-2 rounded-full border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800" data-action="click->division-hub#prev" aria-label="<%= t('divisions.carousel.previous') %>">
            <svg class="h-5 w-5 text-gray-700 dark:text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <div class="flex gap-2" role="tablist" aria-label="<%= t('divisions.carousel.pagination_label') %>">
            <% slides.each_with_index do |_slide, i| %>
              <button type="button"
                      role="tab"
                      data-division-hub-target="dot"
                      data-slide-index="<%= i %>"
                      data-action="click->division-hub#goTo"
                      class="h-2.5 w-2.5 rounded-full <%= i.zero? ? 'bg-blue-600 dark:bg-blue-500' : 'bg-gray-300 dark:bg-gray-600' %>"
                      aria-selected="<%= i.zero? %>"
                      aria-label="<%= t('divisions.carousel.slide', number: i + 1) %>"></button>
            <% end %>
          </div>
          <button type="button" class="p-2 rounded-full border border-gray-300 dark:border-gray-600 hover:bg-gray-50 dark:hover:bg-gray-800" data-action="click->division-hub#next" aria-label="<%= t('divisions.carousel.next') %>">
            <svg class="h-5 w-5 text-gray-700 dark:text-gray-200" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>
