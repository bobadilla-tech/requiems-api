<%# locals: (i18n_scope:) %>
<section class="py-14 bg-gray-950" aria-labelledby="division-how-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 id="division-how-heading" class="text-2xl sm:text-3xl font-bold text-white mb-3 text-center">
      <%= t("divisions.common.how_heading") %>
    </h2>
    <p class="text-sm text-gray-400 text-center max-w-2xl mx-auto mb-12">
      <%= t("divisions.common.how_intro") %>
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-10">
      <% [
           [ "01", "#{i18n_scope}.how_it_works.step1_title", "#{i18n_scope}.how_it_works.step1_body" ],
           [ "02", "#{i18n_scope}.how_it_works.step2_title", "#{i18n_scope}.how_it_works.step2_body" ],
           [ "03", "#{i18n_scope}.how_it_works.step3_title", "#{i18n_scope}.how_it_works.step3_body" ]
         ].each do |num, title_key, body_key| %>
        <div class="border-l-2 border-blue-500 pl-6 flex flex-col">
          <span class="font-mono text-xs font-bold text-blue-400 uppercase tracking-widest mb-3"><%= num %></span>
          <h3 class="text-lg font-semibold text-white mb-2"><%= t(title_key) %></h3>
          <p class="text-sm text-gray-400 leading-relaxed flex-1"><%= t(body_key) %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
