<%# Shared journey; current step is always “division overview” (this page). %>
<section class="py-14 bg-gray-50 dark:bg-gray-950 border-y border-gray-200 dark:border-gray-800" aria-labelledby="division-ux-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 id="division-ux-heading" class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-2 text-center">
      <%= t("divisions.common.ux_flow_heading") %>
    </h2>
    <p class="text-sm text-gray-600 dark:text-gray-400 text-center max-w-2xl mx-auto mb-10">
      <%= t("divisions.common.ux_flow_intro") %>
    </p>

    <ol class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-3 list-none p-0 m-0">
      <% (1..4).each do |n| %>
        <% label_key = "divisions.common.ux_flow.step#{n}_label" %>
        <% hint_key = "divisions.common.ux_flow.step#{n}_hint" %>
        <% current = n == 2 %>
        <li class="relative rounded-2xl border p-5 text-left <%= current ? 'border-blue-500 bg-blue-50/80 dark:bg-blue-950/40 ring-2 ring-blue-500/30 dark:ring-blue-400/25' : 'border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900' %>">
          <% if current %>
            <span class="absolute -top-2.5 left-4 inline-flex items-center rounded-full bg-blue-600 px-2.5 py-0.5 text-xs font-semibold text-white shadow-sm">
              <%= t("divisions.common.ux_flow_badge_current") %>
            </span>
          <% end %>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full text-sm font-bold <%= current ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-800 dark:bg-gray-700 dark:text-gray-100' %> mb-3">
            <%= n %>
          </span>
          <p class="text-sm font-semibold text-gray-900 dark:text-gray-100 leading-snug"><%= t(label_key) %></p>
          <p class="text-xs text-gray-600 dark:text-gray-400 mt-2 leading-relaxed"><%= t(hint_key) %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>
