<div class="relative overflow-hidden text-white" style="background: linear-gradient(135deg, #0f766e 0%, #1D9E75 50%, #065f46 100%);">
  <!-- Background pattern -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%23ffffff&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <!-- Left: Hero copy -->
      <div>
        <span class="inline-flex items-center gap-1.5 text-sm font-medium rounded-full px-3 py-1 mb-6"
              style="background-color: rgba(255,255,255,0.15); color: #d1fae5;">
          <%= t("tools.domain_checker.hero.badge") %>
        </span>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6">
          <%= t("tools.domain_checker.hero.title") %>
          <span class="block" style="color: #a7f3d0;"><%= t("tools.domain_checker.hero.title_highlight") %></span>
        </h1>

        <p class="text-xl mb-8" style="color: #d1fae5;">
          <%= t("tools.domain_checker.hero.subtitle") %>
        </p>

        <!-- Proof badges -->
        <div class="flex flex-wrap gap-x-4 gap-y-2 mb-8">
          <% [
            t("shared.common.json_response"),
            t("shared.common.uptime"),
            t("shared.common.latency"),
            t("shared.common.rest_api")
          ].each do |badge| %>
            <span class="flex items-center gap-1.5 text-sm" style="color: #a7f3d0;">
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <%= badge %>
            </span>
          <% end %>
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-col sm:flex-row gap-4">
          <% unless user_signed_in? %>
            <%= render "partials/shared/button",
                  text:    t("tools.domain_checker.hero.cta_primary"),
                  variant: "brand",
                  href:    new_user_registration_path,
                  size:    "lg" %>
          <% end %>
          <%= render "partials/shared/button",
                text:    t("tools.domain_checker.hero.cta_docs"),
                variant: "outline-white",
                href:    api_path("domain-info"),
                size:    "lg" %>
        </div>
      </div>

      <!-- Right: Live demo (Turbo Frame) -->
      <div class="w-full min-w-0"
           data-controller="domain-checker-demo"
           data-domain-checker-demo-error-empty-value="<%= t('tools.domain_checker.demo.error_empty') %>">

        <div class="rounded-2xl overflow-hidden w-full"
             style="background-color: #0d1117; border: 1px solid rgba(255,255,255,0.07); box-shadow: 0 25px 50px rgba(0,0,0,0.4), 0 0 40px rgba(29,158,117,0.1);">

          <!-- Titlebar -->
          <div class="px-4 py-3 flex items-center gap-3"
               style="background-color: #161b22; border-bottom: 1px solid rgba(255,255,255,0.05);">
            <div class="flex items-center gap-1.5 shrink-0">
              <div class="w-3 h-3 rounded-full" style="background-color: #ff5f57;"></div>
              <div class="w-3 h-3 rounded-full" style="background-color: #febc2e;"></div>
              <div class="w-3 h-3 rounded-full" style="background-color: #28c840;"></div>
            </div>
            <span class="flex-1 text-center text-xs font-mono" style="color: #e2e8f0;"><%= t("tools.domain_checker.hero.try_live") %></span>
            <div class="shrink-0 w-14"></div>
          </div>

          <!-- Form -->
          <div class="px-5 pt-5 pb-5">
            <form data-action="turbo:submit-start->domain-checker-demo#onSubmitStart turbo:submit-end->domain-checker-demo#onSubmitEnd"
                  action="<%= tool_demo_domain_checker_path %>"
                  method="post"
                  data-turbo-frame="domain_checker-demo-result"
                  novalidate>
              <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

              <label for="domain-checker-demo-input" class="sr-only"><%= t("tools.domain_checker.hero.label_input") %></label>
              <div class="flex gap-2">
                <input id="domain-checker-demo-input"
                       name="domain"
                       type="text"
                       placeholder="<%= t('tools.domain_checker.hero.placeholder') %>"
                       autocomplete="off"
                       data-domain-checker-demo-target="input"
                       class="flex-1 block w-full rounded-lg border px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-primary"
                       style="background-color: #161b22; border-color: rgba(255,255,255,0.1); color: #e2e8f0;">
                <button type="submit"
                        data-domain-checker-demo-target="button"
                        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg font-semibold text-sm transition-colors disabled:opacity-60 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:ring-offset-2 shrink-0"
                        style="background-color: #1D9E75; color: white;">
                  <span data-domain-checker-demo-target="spinner" class="hidden">
                    <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                    </svg>
                  </span>
                  <%= t("tools.domain_checker.demo.submit") %>
                </button>
              </div>

              <p data-domain-checker-demo-target="errorMessage"
                 class="hidden mt-2 text-xs"
                 style="color: #f87171;"
                 role="alert"></p>

              <p class="mt-2 text-xs" style="color: rgba(255,255,255,0.4);"><%= t("tools.domain_checker.hero.no_account") %></p>
            </form>

            <turbo-frame id="domain_checker-demo-result"></turbo-frame>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>
