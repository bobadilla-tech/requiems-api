<section class="bg-gray-50 dark:bg-gray-900 py-20 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100">
        Frequently Asked Questions
      </h2>
    </div>

    <div class="space-y-3">
      <% [
        {
          q: "What does Domain Checker check exactly?",
          a: "It checks DNS record existence, MX record presence, SSL certificate validity, and domain reputation against known threat lists."
        },
        {
          q: "Does it verify if the domain has a mail server?",
          a: "Yes. The mx_valid field indicates whether the domain has valid MX records configured — a prerequisite for receiving email."
        },
        {
          q: "Does it check SSL certificates?",
          a: "Yes. ssl_valid returns true if the domain has a valid, non-expired SSL certificate. It does not check chain depth or extended validation status."
        },
        {
          q: "Can it validate multiple domains at once?",
          a: "The endpoint accepts one domain per request. For bulk validation, call in parallel or use the batch endpoint if available on your plan."
        },
        {
          q: "Is it free to use the demo?",
          a: "The interactive demo requires no account. A free tier is available after signup with a monthly request quota. See the pricing page for limits."
        },
      ].each_with_index do |item, i| %>
        <%= render "partials/shared/card", padding: true do %>
          <div data-controller="faq-accordion">
            <button id="faq-dc-btn-<%= i %>"
                    class="w-full flex justify-between items-center text-left gap-4"
                    aria-expanded="false"
                    aria-controls="faq-dc-panel-<%= i %>"
                    data-action="click->faq-accordion#toggle">
              <span class="text-base font-semibold text-gray-900 dark:text-gray-100">
                <%= item[:q] %>
              </span>
              <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform duration-200"
                   fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
              </svg>
            </button>

            <div id="faq-dc-panel-<%= i %>"
                 role="region"
                 aria-labelledby="faq-dc-btn-<%= i %>"
                 class="hidden prose text-sm text-gray-600 dark:text-gray-400 mt-3">
              <%= item[:a] %>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>

    <div class="mt-10 text-center">
      <p class="text-gray-500 dark:text-gray-400 text-sm mb-3">Still have questions?</p>
      <%= link_to contact_path, class: "inline-flex items-center text-sm font-medium hover:underline", style: "color: #1D9E75;" do %>
        Contact support
        <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      <% end %>
    </div>
  </div>
</section>
