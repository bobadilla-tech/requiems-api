<section class="bg-white dark:bg-gray-950 py-16 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">
        Pair It With Other APIs
      </h2>
      <p class="mt-3 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        Domain Checker is more powerful combined. Stack it with other Requiems APIs to build multi-point validation into a single workflow.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% [
        {
          name:    "Domain Checker + Email Validator",
          benefit: "Validate both the domain and specific email address.",
          outcome: "Full email deliverability confidence: domain health plus mailbox-level checks."
        },
        {
          name:    "Domain Checker + VPN Detection",
          benefit: "Check domain health while identifying VPN or proxy traffic from the same request.",
          outcome: "Double-layered fraud signal: a flagged domain combined with anonymized traffic is a strong block trigger."
        },
        {
          name:    "Domain Checker + Phone Validator",
          benefit: "Verify domain health and phone number at the same onboarding step.",
          outcome: "Multi-point contact validation — confirmed digital presence and reachable phone — before granting access."
        },
      ].each do |combo| %>
        <div class="bg-gray-50 dark:bg-gray-800 rounded-xl p-5 border border-gray-200 dark:border-gray-700">
          <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-3">
            <%= combo[:name] %>
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
            <span class="font-medium text-gray-700 dark:text-gray-300">Benefit:</span>
            <%= combo[:benefit] %>
          </p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            <span class="font-medium text-gray-700 dark:text-gray-300">Outcome:</span>
            <%= combo[:outcome] %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</section>
