<%# locals: (feature:, ours:, theirs:) %>
<tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
  <td class="py-3 px-4 text-sm text-gray-700 dark:text-gray-300 font-medium"><%= feature %></td>
  <td class="py-3 px-4 text-center bg-blue-50/50 dark:bg-blue-900/10">
    <% if ours == true %>
      <svg class="h-5 w-5 text-green-500 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-label="<%= t('shared.labels.yes') %>">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
      </svg>
    <% elsif ours == false %>
      <svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-label="<%= t('shared.labels.no') %>">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    <% else %>
      <span class="text-xs text-gray-600 dark:text-gray-400"><%= ours %></span>
    <% end %>
  </td>
  <td class="py-3 px-4 text-center">
    <% if theirs == true %>
      <svg class="h-5 w-5 text-green-500 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-label="<%= t('shared.labels.yes') %>">
        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
      </svg>
    <% elsif theirs == false %>
      <svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-label="<%= t('shared.labels.no') %>">
        <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
      </svg>
    <% else %>
      <span class="text-xs text-gray-600 dark:text-gray-400"><%= theirs %></span>
    <% end %>
  </td>
</tr>
