<%# locals: (i18n_scope:) %>
<section class="py-20 bg-gradient-to-br from-blue-600 to-indigo-800">
  <div class="max-w-3xl mx-auto px-4 text-center text-white">
    <h2 class="text-3xl sm:text-4xl font-bold mb-4"><%= t("#{i18n_scope}.final_cta.headline") %></h2>
    <p class="text-lg text-blue-100 mb-8"><%= t("#{i18n_scope}.final_cta.subheadline") %></p>
    <%= link_to cal_com_strategy_url, target: "_blank", rel: "noopener noreferrer",
        class: "inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-lg font-semibold text-blue-900 bg-white hover:bg-blue-50 shadow-lg transition-colors" do %>
      <%= t("#{i18n_scope}.final_cta.cta") %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
      </svg>
    <% end %>
  </div>
</section>
