<%# locals: (i18n_scope:) %>
<% items = division_locale_array(i18n_scope, "proof_points.items") %>
<% return if items.empty? %>
<section class="py-16 bg-gray-50 dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800" aria-labelledby="industry-proof-points-heading">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 id="industry-proof-points-heading" class="text-2xl font-bold text-center text-gray-900 dark:text-gray-100 mb-10">
      <%= t("#{i18n_scope}.proof_points.heading") %>
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
      <% items.each do |item| %>
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-6">
          <% if item[:metric].present? %>
            <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-2"><%= item[:metric] %></div>
          <% end %>
          <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1"><%= item[:title] %></h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed"><%= item[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
