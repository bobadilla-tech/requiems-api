<div class="bg-slate-900 py-20 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12">
      <p class="text-xs font-semibold uppercase tracking-widest text-blue-400 mb-4">
        <%= t("home.index.engine_spotlight.kicker") %>
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-5 leading-tight max-w-2xl">
        <%= t("home.index.engine_spotlight.heading") %>
      </h2>
      <p class="text-lg text-slate-300 max-w-2xl mb-6">
        <%= t("home.index.engine_spotlight.subheading") %>
      </p>
      <%= link_to systems_path, class: "inline-flex items-center text-sm font-semibold text-blue-400 hover:text-blue-300 transition-colors" do %>
        <%= t("home.index.engine_spotlight.cta") %>
        <svg class="ml-1.5 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      <% end %>
    </div>

    <%# Request / Response side by side %>
    <div class="grid lg:grid-cols-2 gap-4" data-controller="highlight">
      <%# Request %>
      <div class="rounded-2xl overflow-hidden" style="background-color:#0d1117; border:1px solid rgba(255,255,255,0.08); box-shadow:0 20px 40px rgba(0,0,0,0.5);">
        <div class="px-4 py-3 flex items-center gap-3" style="background-color:#161b22; border-bottom:1px solid rgba(255,255,255,0.06);">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full" style="background:#ff5f57;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#febc2e;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#28c840;"></div>
          </div>
          <div class="flex items-center gap-2 ml-1">
            <span class="text-xs font-bold font-mono px-1.5 py-0.5 rounded" style="background:rgba(96,165,250,0.15); color:#93c5fd;">POST</span>
            <span class="text-xs font-mono" style="color:#94a3b8;"><%= t("home.index.engine_spotlight.endpoint") %></span>
          </div>
          <span class="ml-auto text-xs font-mono" style="color:#94a3b8;">Request</span>
        </div>
        <pre class="px-5 py-5 text-sm font-mono leading-relaxed overflow-x-auto !bg-transparent m-0"><code class="language-json"><%= t("home.index.engine_spotlight.request") %></code></pre>
      </div>

      <%# Response %>
      <div class="rounded-2xl overflow-hidden" style="background-color:#0d1117; border:1px solid rgba(255,255,255,0.08); box-shadow:0 20px 40px rgba(0,0,0,0.5);">
        <div class="px-4 py-3 flex items-center" style="background-color:#161b22; border-bottom:1px solid rgba(255,255,255,0.06);">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full" style="background:#ff5f57;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#febc2e;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#28c840;"></div>
          </div>
          <span class="ml-auto text-xs font-mono" style="color:#94a3b8;">Response</span>
        </div>
        <pre class="px-5 py-5 text-sm font-mono leading-relaxed overflow-x-auto !bg-transparent m-0"><code class="language-json"><%= t("home.index.engine_spotlight.response") %></code></pre>
      </div>
    </div>

    <%# Plain-language value table %>
    <div class="mt-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">
        <%= t("home.index.engine_spotlight.value_table_heading") %>
      </p>
      <div class="divide-y divide-white/5">
        <% t("home.index.engine_spotlight.value_table").each do |row| %>
          <div class="flex items-baseline gap-4 py-3">
            <code class="shrink-0 text-xs font-mono px-2 py-0.5 rounded" style="background:rgba(96,165,250,0.12); color:#93c5fd;"><%= row[:field] %></code>
            <span class="text-sm text-slate-300"><%= row[:plain] %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
