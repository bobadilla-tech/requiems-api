<div class="bg-gray-50 dark:bg-gray-950 py-20 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-4xl font-bold text-gray-900 dark:text-gray-100">
        <%= t("home.index.how_it_works.heading") %>
      </h2>
    </div>

    <div class="grid sm:grid-cols-3 gap-8">
      <% [1, 2, 3].each do |n| %>
        <div class="text-center">
          <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-blue-600 text-white text-lg font-bold mb-5">
            <%= n %>
          </div>
          <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2">
            <%= t("home.index.how_it_works.step#{n}_title") %>
          </h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">
            <%= t("home.index.how_it_works.step#{n}_body") %>
          </p>
        </div>
      <% end %>
    </div>
  </div>
</div>
