<div class="bg-gray-50 dark:bg-gray-950 py-20 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-gray-100">
        <%= t("home.index.use_cases.heading") %>
      </h2>
      <p class="mt-3 text-lg text-gray-600 dark:text-gray-400">
        <%= t("home.index.use_cases.subheading") %>
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-5">
      <% t("home.index.use_cases.items").each do |item| %>
        <div class="rounded-xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 px-7 py-6">
          <h3 class="text-base font-bold text-gray-900 dark:text-gray-100 mb-1"><%= item[:title] %></h3>
          <p class="text-sm text-gray-600 dark:text-gray-400"><%= item[:body] %></p>
        </div>
      <% end %>
    </div>
  </div>
</div>
