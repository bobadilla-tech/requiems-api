<% cards = [
  {
    icon: "💬",
    title: t('tools.sentiment_analysis.use_cases.customer_support_title'),
    body: t('tools.sentiment_analysis.use_cases.customer_support_body')
  },
  {
    icon: "⭐",
    title: t('tools.sentiment_analysis.use_cases.product_reviews_title'),
    body: t('tools.sentiment_analysis.use_cases.product_reviews_body')
  },
  {
    icon: "📣",
    title: t('tools.sentiment_analysis.use_cases.social_media_title'),
    body: t('tools.sentiment_analysis.use_cases.social_media_body')
  },
  {
    icon: "🛡️",
    title: t('tools.sentiment_analysis.use_cases.content_moderation_title'),
    body: t('tools.sentiment_analysis.use_cases.content_moderation_body')
  },
  {
    icon: "🤖",
    title: t('tools.sentiment_analysis.use_cases.nlp_pipelines_title'),
    body: t('tools.sentiment_analysis.use_cases.nlp_pipelines_body')
  },
  {
    icon: "📊",
    title: t('tools.sentiment_analysis.use_cases.survey_analysis_title'),
    body: t('tools.sentiment_analysis.use_cases.survey_analysis_body')
  }
] %>

<section class="bg-white dark:bg-gray-900 py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t('tools.sentiment_analysis.use_cases.built_for_real_use_cases') %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t('tools.sentiment_analysis.use_cases.anywhere_text_flows_through_your_system') %></p>


    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% cards.each do |card| %>
        <div class="rounded-2xl border border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-6">
          <div class="text-3xl mb-3"><%= card[:icon] %></div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-1"><%= card[:title] %></h3>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= card[:body] %></p>
        </div>
      <% end %>
    </div>

  </div>
</section>
