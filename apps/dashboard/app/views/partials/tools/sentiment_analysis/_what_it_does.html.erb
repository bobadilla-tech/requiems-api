<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("tools.sentiment_analysis.what_it_does.what_it_does") %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t("tools.sentiment_analysis.what_it_does.one_call_three_values_enough_signal_to") %></p>
    </div>

    <div class="grid md:grid-cols-2 gap-8">

      <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300 mb-4">
          <%= t("tools.sentiment_analysis.what_it_does.instant_classification") %>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2"><%= t("tools.sentiment_analysis.what_it_does.positive_negative_or_neutral") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">
          <%= t("tools.sentiment_analysis.what_it_does.classification_body") %>
        </p>
        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "sentiment": "positive",
  "score": 0.97
}
        <% end %>
      </div>

      <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 mb-4">
          <%= t("tools.sentiment_analysis.what_it_does.full_breakdown") %>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2"><%= t("tools.sentiment_analysis.what_it_does.proportional_scores_across_all_classes") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">
          <%= t("tools.sentiment_analysis.what_it_does.breakdown_body") %>
        </p>
        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "breakdown": {
    "positive": 0.97,
    "negative": 0.01,
    "neutral": 0.02
  }
}
        <% end %>
      </div>

    </div>
  </div>
</section>
