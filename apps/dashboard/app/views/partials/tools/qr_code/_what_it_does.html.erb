<section class="bg-gray-50 dark:bg-gray-900 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("tools.qr_code.what_it_does.heading") %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
        <%= t("tools.qr_code.what_it_does.subheading") %>
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-8 items-start">

      <!-- Two response formats -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("tools.qr_code.what_it_does.coverage_heading") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
          <%= t("tools.qr_code.what_it_does.coverage_body") %>
        </p>
        <div class="mt-6 rounded-lg bg-gray-900 text-green-400 font-mono text-xs p-4 overflow-x-auto">
          <pre>GET /v1/technology/qr?data=https://example.com
GET /v1/technology/qr/base64?data=https://example.com</pre>
        </div>
      </div>

      <!-- Simplicity -->
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("tools.qr_code.what_it_does.simplicity_heading") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed">
          <%= t("tools.qr_code.what_it_does.simplicity_body") %>
        </p>
        <div class="mt-6 rounded-lg bg-gray-900 text-green-400 font-mono text-xs p-4 overflow-x-auto">
          <pre>{
  "data": {
    "image": "iVBORw0KGgoAAAANS...",
    "width": 256,
    "height": 256
  }
}</pre>
        </div>
      </div>

    </div>
  </div>
</section>
