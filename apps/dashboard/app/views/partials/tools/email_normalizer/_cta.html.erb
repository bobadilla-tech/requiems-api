<section class="bg-gray-900 dark:bg-gray-950 py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h2 class="text-3xl sm:text-4xl font-bold text-white">
      Automate this with Requiems.
    </h2>
    <p class="mt-4 text-lg text-gray-400 max-w-xl mx-auto">
      One API key. Email normalization and more across Requiems.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row gap-4 justify-center">
      <%= link_to new_user_registration_path,
            class: "inline-flex items-center justify-center px-6 py-3 rounded-lg text-white font-semibold text-base shadow-sm transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-900",
            style: "background-color:#1D9E75;" do %>
        Get your free API key
      <% end %>

      <%= link_to api_path("email-normalize"),
            class: "inline-flex items-center justify-center px-6 py-3 rounded-lg border border-white/60 text-white font-semibold text-base hover:bg-white/10 hover:border-white transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-gray-900" do %>
        Read the docs →
      <% end %>
    </div>

  </div>
</section>
