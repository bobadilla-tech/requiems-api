<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid md:grid-cols-2 gap-12">

      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-primary text-white mb-4"><%= t("tools.email_normalizer.what_it_does.clean_data_badge") %></span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.email_normalizer.what_it_does.clean_data_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.email_normalizer.what_it_does.clean_data_body") %>
          </p>
        </div>

        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "email": "  User+tag@Googlemail.COM  ",
  "normalized": "user@gmail.com",
  "local": "user",
  "domain": "gmail.com",
  "issues": "alias_resolved"
}
        <% end %>
      </div>

      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 mb-4"><%= t("tools.email_normalizer.what_it_does.integration_badge") %></span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.email_normalizer.what_it_does.integration_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.email_normalizer.what_it_does.integration_body") %>
          </p>
        </div>

        <%= render "partials/tools/shared/code_sample", language: "http" do %>
POST /v1/text/normalize
Host: requiems.xyz
requiems-api-key: YOUR_API_KEY
Content-Type: application/json

{"email": "User@Example.COM"}
        <% end %>
      </div>

    </div>
  </div>
</section>
