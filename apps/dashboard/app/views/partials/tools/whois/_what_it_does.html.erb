<section class="bg-gray-50 dark:bg-gray-900 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("tools.whois.what_it_does.heading") %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
        <%= t("tools.whois.what_it_does.subheading") %>
      </p>
    </div>
    <div class="grid md:grid-cols-2 gap-8 items-start">
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("tools.whois.what_it_does.output_heading") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed mb-6">
          <%= t("tools.whois.what_it_does.output_body") %>
        </p>
        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "domain": "example.com",
  "registrar": "RESERVED-Internet Assigned Numbers Authority",
  "name_servers": ["A.IANA-SERVERS.NET", "B.IANA-SERVERS.NET"],
  "status": ["clientTransferProhibited"],
  "created_date": "1995-08-14T04:00:00Z",
  "expiry_date": "2024-08-13T04:00:00Z",
  "dnssec": true
}
        <% end %>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl border border-gray-200 dark:border-gray-700 p-8">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3"><%= t("tools.whois.what_it_does.simplicity_heading") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm leading-relaxed mb-6">
          <%= t("tools.whois.what_it_does.simplicity_body") %>
        </p>
        <%= render "partials/tools/shared/code_sample", language: "http" do %>
GET /v1/networking/whois/example.com
Host: requiems.xyz
requiems-api-key: YOUR_API_KEY
        <% end %>
      </div>
    </div>
  </div>
</section>
