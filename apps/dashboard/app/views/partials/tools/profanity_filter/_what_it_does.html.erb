<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid md:grid-cols-2 gap-12">

      <!-- Detection -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-primary text-white mb-4">
            <%= t("tools.profanity_filter.what_it_does.detection_badge") %>
          </span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.profanity_filter.what_it_does.detection_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.profanity_filter.what_it_does.detection_body") %>
          </p>
        </div>

        <!-- Mock response card -->
        <div class="rounded-xl bg-gray-900 dark:bg-gray-950 p-5 font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 mb-2 text-[11px]">POST /v1/validation/profanity → 200 OK</div>
          <div>
            <span class="text-gray-500">{</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"has_profanity"</span><span class="text-gray-500">:</span> <span class="text-purple-400">true</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"censored"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"This is a **** example"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"flagged_words"</span><span class="text-gray-500">: [</span><span class="text-amber-300">"damn"</span><span class="text-gray-500">]</span><br>
            <span class="text-gray-500">}</span>
          </div>
        </div>
      </div>

      <!-- Censorship -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 mb-4">
            <%= t("tools.profanity_filter.what_it_does.censorship_badge") %>
          </span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.profanity_filter.what_it_does.censorship_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.profanity_filter.what_it_does.censorship_body") %>
          </p>
        </div>

        <!-- Mock request card -->
        <div class="rounded-xl bg-gray-900 dark:bg-gray-950 p-5 font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 mb-2 text-[11px]">Request</div>
          <div>
            <span class="text-sky-300">POST</span> <span class="text-gray-300">/v1/validation/profanity</span><br><br>
            <span class="text-gray-500"># Headers</span><br>
            <span class="text-sky-300">requiems-api-key</span><span class="text-gray-500">:</span> <span class="text-amber-300">YOUR_API_KEY</span><br><br>
            <span class="text-gray-500"># Body</span><br>
            <span class="text-gray-500">{</span> <span class="text-sky-300">"text"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"This is a damn example"</span> <span class="text-gray-500">}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
