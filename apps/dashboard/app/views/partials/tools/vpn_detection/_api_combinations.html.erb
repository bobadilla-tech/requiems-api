<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("tools.vpn_detection.api_combinations.heading") %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        <%= t("tools.vpn_detection.api_combinations.subheading") %>
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      <% [
        { pair:    t("tools.vpn_detection.api_combinations.bin_pair"),
          benefit: t("tools.vpn_detection.api_combinations.bin_benefit"),
          href:    "/apis/bin-lookup" },
        { pair:    t("tools.vpn_detection.api_combinations.identity_pair"),
          benefit: t("tools.vpn_detection.api_combinations.identity_benefit"),
          href:    "/apis/identity-risk" },
        { pair:    t("tools.vpn_detection.api_combinations.email_pair"),
          benefit: t("tools.vpn_detection.api_combinations.email_benefit"),
          href:    "/apis/email-validate" },
      ].each do |c| %>
        <a href="<%= c[:href] %>" class="block rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 hover:shadow-md transition-shadow no-underline">
          <div class="font-semibold text-gray-900 dark:text-white mb-3 leading-snug">
            <%= c[:pair] %>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= c[:benefit] %>
          </p>
        </a>
      <% end %>
    </div>

  </div>
</section>
