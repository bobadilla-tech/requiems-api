<%
  cta_heading      = local_assigns.fetch(:heading)
  cta_body         = local_assigns.fetch(:body)
  cta_docs_url     = local_assigns.fetch(:docs_url)
  cta_primary_text = local_assigns.fetch(:cta_primary)
  cta_docs_text    = local_assigns.fetch(:cta_docs)
%>
<section class="bg-gray-900 dark:bg-gray-950 py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h2 class="text-3xl sm:text-4xl font-bold text-white">
      <%= cta_heading %>
    </h2>
    <p class="mt-4 text-lg text-gray-400 max-w-xl mx-auto">
      <%= cta_body %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <%= link_to new_user_registration_path,
            class: "inline-flex items-center px-7 py-3 rounded-lg bg-brand-primary text-white font-semibold text-base shadow-sm transition-opacity hover:opacity-90" do %>
        <%= cta_primary_text %>
      <% end %>

      <%= link_to cta_docs_url,
            class: "inline-flex items-center px-7 py-3 rounded-lg border border-gray-600 text-gray-300 font-semibold text-base hover:bg-gray-800 transition-colors" do %>
        <%= cta_docs_text %>
      <% end %>
    </div>

  </div>
</section>
