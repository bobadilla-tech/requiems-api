<%# Standard Highlight.js code sample. Locals: language ("json" or "http"). %>
<%# Pass sample source as the block body. Do not hand-roll Tailwind color spans. %>
<% unless @highlight_head_rendered %>
  <% @highlight_head_rendered = true %>
  <% content_for :head do %>
    <%= render "partials/shared/highlight_head" %>
  <% end %>
<% end %>
<div data-controller="highlight">
  <pre><code class="language-<%= language %>"><%== capture { yield }.to_s.sub(/\A\n/, "") %></code></pre>
</div>
