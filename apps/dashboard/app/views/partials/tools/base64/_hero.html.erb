<%#
  Mode/variant option values MUST match what the Base64 API accepts:
  mode: encode, decode. variant: standard, url.
%>
<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      <%= t("tools.base64.hero.title") %>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      <%= t("tools.base64.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t("tools.base64.hero.cta_primary"),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t("tools.base64.hero.cta_docs"),
            variant: "outline",
            href: api_path("base64"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="base64-demo"
         data-base64-demo-error-empty-value="<%= t('tools.base64.demo.error_empty') %>">

      <form data-action="turbo:submit-start->base64-demo#onSubmitStart turbo:submit-end->base64-demo#onSubmitEnd"
            action="<%= tool_demo_base64_path %>"
            method="post"
            data-turbo-frame="base64-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex flex-col gap-2">
          <div class="grid grid-cols-2 gap-2">
            <div>
              <label for="base64-demo-mode" class="sr-only"><%= t("tools.base64.hero.label_mode") %></label>
              <select
                id="base64-demo-mode"
                name="mode"
                data-base64-demo-target="mode"
                class="block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
              >
                <option value="encode"><%= t("tools.base64.hero.mode_encode") %></option>
                <option value="decode"><%= t("tools.base64.hero.mode_decode") %></option>
              </select>
            </div>
            <div>
              <label for="base64-demo-variant" class="sr-only"><%= t("tools.base64.hero.label_variant") %></label>
              <select
                id="base64-demo-variant"
                name="variant"
                data-base64-demo-target="variant"
                class="block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
              >
                <option value="standard"><%= t("tools.base64.hero.variant_standard") %></option>
                <option value="url"><%= t("tools.base64.hero.variant_url") %></option>
              </select>
            </div>
          </div>
          <label for="base64-demo-value" class="sr-only"><%= t("tools.base64.hero.label_value") %></label>
          <textarea
            id="base64-demo-value"
            name="value"
            rows="3"
            data-base64-demo-target="input"
            placeholder="<%= t('tools.base64.hero.placeholder_value') %>"
            autocomplete="off"
            class="block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm font-mono"
          ></textarea>
          <div class="flex justify-between items-center">
            <p class="text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("tools.base64.hero.no_account") %></p>
            <%= render "partials/shared/submit_button", text: t("tools.base64.hero.submit"), controller: "base64-demo" %>
          </div>
        </div>

        <p data-base64-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="base64-demo-result"></turbo-frame>
    </div>

  </div>
</section>
