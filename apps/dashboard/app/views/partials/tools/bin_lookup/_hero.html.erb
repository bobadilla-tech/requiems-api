<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      <%= t("tools.bin_lookup.hero.title") %>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      <%= t("tools.bin_lookup.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t("tools.bin_lookup.hero.cta_primary"),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t("tools.bin_lookup.hero.cta_docs"),
            variant: "outline",
            href: api_path("bin-lookup"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="bin-lookup-demo"
         data-bin-lookup-demo-error-empty-value="<%= t('tools.bin_lookup.demo.error_empty') %>">

      <form data-action="turbo:submit-start->bin-lookup-demo#onSubmitStart turbo:submit-end->bin-lookup-demo#onSubmitEnd"
            action="<%= tool_demo_bin_lookup_path %>"
            method="post"
            data-turbo-frame="bin_lookup-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex gap-2">
          <label for="bin-lookup-demo-input" class="sr-only"><%= t("tools.bin_lookup.hero.label_input") %></label>
          <input
            id="bin-lookup-demo-input"
            type="text"
            name="bin"
            inputmode="numeric"
            pattern="[0-9]{6,8}"
            minlength="6"
            maxlength="8"
            data-bin-lookup-demo-target="input"
            placeholder="<%= t('tools.bin_lookup.hero.placeholder') %>"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
          <%= render "partials/shared/submit_button", text: t("tools.bin_lookup.hero.submit"), controller: "bin-lookup-demo" %>
        </div>

        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("tools.bin_lookup.hero.no_account") %></p>

        <p data-bin-lookup-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="bin_lookup-demo-result"></turbo-frame>
    </div>

  </div>
</section>
