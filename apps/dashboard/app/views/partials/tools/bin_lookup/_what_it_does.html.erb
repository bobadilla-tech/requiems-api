<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid md:grid-cols-2 gap-12">

      <!-- Coverage -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-primary text-white mb-4">
            <%= t("tools.bin_lookup.what_it_does.coverage_badge") %>
          </span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.bin_lookup.what_it_does.coverage_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.bin_lookup.what_it_does.coverage_body") %>
          </p>
        </div>

        <!-- Mock response card -->
        <div class="rounded-xl bg-gray-900 dark:bg-gray-950 p-5 font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 mb-2 text-[11px]">GET /v1/finance/bin/424242 → 200 OK</div>
          <div>
            <span class="text-gray-500">{</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"bin"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"424242"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"scheme"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"visa"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"card_type"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"credit"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"card_level"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"classic"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"issuer_name"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"Chase"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"country_code"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"US"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"prepaid"</span><span class="text-gray-500">:</span> <span class="text-purple-400">false</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"confidence"</span><span class="text-gray-500">:</span> <span class="text-purple-400">0.92</span><br>
            <span class="text-gray-500">}</span>
          </div>
        </div>
      </div>

      <!-- Simplicity -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 mb-4">
            <%= t("tools.bin_lookup.what_it_does.simplicity_badge") %>
          </span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.bin_lookup.what_it_does.simplicity_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.bin_lookup.what_it_does.simplicity_body") %>
          </p>
        </div>

        <!-- Mock request card -->
        <div class="rounded-xl bg-gray-900 dark:bg-gray-950 p-5 font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 mb-2 text-[11px]">Request</div>
          <div>
            <span class="text-sky-300">GET</span> <span class="text-gray-300">/v1/finance/bin/424242</span><br><br>
            <span class="text-gray-500"># Headers</span><br>
            <span class="text-sky-300">requiems-api-key</span><span class="text-gray-500">:</span> <span class="text-amber-300">YOUR_API_KEY</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
