<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      Convert measurements instantly<br class="hidden sm:block">  across every unit type.
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      Length, weight, volume, temperature, area, and speed conversions — with precise results, conversion formulas, and unit discovery endpoints in a single API.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= link_to new_user_registration_path,
            class: "inline-flex items-center px-6 py-3 rounded-lg bg-brand-primary text-white font-semibold text-base shadow-sm transition-colors" do %>
        Get API Key
        <svg class="ml-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
      <%= link_to api_path("unit-conversion"),
            class: "inline-flex items-center px-6 py-3 rounded-lg border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-300 font-semibold text-base hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors" do %>
        Read the docs
      <% end %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="unit-conversion-demo">

      <form data-action="submit->unit-conversion-demo#verify" novalidate>
        <div class="flex flex-col gap-2">
          <label for="unit-conversion-for-demo-input" class="sr-only">  Source unit </label>
          <input
            id="unit-conversion-for-demo-input"
            type="text"
            data-unit-conversion-demo-target="from"
            placeholder="Source unit (e.g. miles)"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
          <label for="unit-conversion-to-demo-input" class="sr-only">  Target unit </label>
          <input
            id="unit-conversion-to-demo-input"
            type="text"
            data-unit-conversion-demo-target="to"
            placeholder="Target unit (e.g. km)"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
          <label for="unit-conversion-value-demo-input" class="sr-only"> Value </label>
         <input
            id="unit-conversion-value-demo-input"
            type="number"
            data-unit-conversion-demo-target="value"
            placeholder="Enter a value"
            autocomplete="off"
            class="no-spinner flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          />
          <div class="flex justify-between ">
            <p class="mt-2 flex text-xs text-gray-400 dark:text-gray-500 text-left">No account required for the demo.</p>
            <button
              type="submit"
              data-unit-conversion-demo-target="button"
              class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-brand-primary text-white font-semibold text-sm transition-colors disabled:opacity-60"
          >
              <span data-unit-conversion-demo-target="spinner" class="hidden">
                <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
                </svg>
              </span>
              Convert 
            </button>
          </div>
        </div>


        <p data-unit-conversion-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <div data-unit-conversion-demo-target="result"
           class="hidden mt-4 text-left">
      </div>
    </div>

  </div>
</section>
