<%#
  Unit option values MUST be keys the Units API accepts (canonical or aliases).
  Labels stay human-readable via t(). Canonical keys come from
  apps/api/services/technology/units/service.go.
%>
<% unit_options = [
  { group: t("tools.unit_conversion.hero.group_length"), options: [
    ["m", t("tools.unit_conversion.hero.meters")],
    ["km", t("tools.unit_conversion.hero.kilometers")],
    ["miles", t("tools.unit_conversion.hero.miles")],
    ["ft", t("tools.unit_conversion.hero.feet")],
    ["in", t("tools.unit_conversion.hero.inches")],
    ["yd", t("tools.unit_conversion.hero.yards")],
    ["cm", t("tools.unit_conversion.hero.centimeters")],
    ["mm", t("tools.unit_conversion.hero.millimeters")],
    ["nmi", t("tools.unit_conversion.hero.nautical_miles")],
  ]},
  { group: t("tools.unit_conversion.hero.group_weight"), options: [
    ["kg", t("tools.unit_conversion.hero.kilograms")],
    ["g", t("tools.unit_conversion.hero.grams")],
    ["lb", t("tools.unit_conversion.hero.pounds")],
    ["oz", t("tools.unit_conversion.hero.ounces")],
    ["t", t("tools.unit_conversion.hero.tons_metric")],
    ["stone", t("tools.unit_conversion.hero.stone")],
    ["mg", t("tools.unit_conversion.hero.milligrams")],
  ]},
  { group: t("tools.unit_conversion.hero.group_temperature"), options: [
    ["c", t("tools.unit_conversion.hero.celsius")],
    ["f", t("tools.unit_conversion.hero.fahrenheit")],
    ["k", t("tools.unit_conversion.hero.kelvin")],
  ]},
  { group: t("tools.unit_conversion.hero.group_volume"), options: [
    ["l", t("tools.unit_conversion.hero.liters")],
    ["ml", t("tools.unit_conversion.hero.milliliters")],
    ["gal", t("tools.unit_conversion.hero.gallons_us")],
    ["qt", t("tools.unit_conversion.hero.quarts")],
    ["pt", t("tools.unit_conversion.hero.pints")],
    ["cup", t("tools.unit_conversion.hero.cups")],
    ["fl_oz", t("tools.unit_conversion.hero.fluid_ounces")],
    ["tsp", t("tools.unit_conversion.hero.teaspoons")],
    ["tbsp", t("tools.unit_conversion.hero.tablespoons")],
  ]},
  { group: t("tools.unit_conversion.hero.group_speed"), options: [
    ["m_s", t("tools.unit_conversion.hero.meters_second")],
    ["km_h", t("tools.unit_conversion.hero.km_hour")],
    ["mph", t("tools.unit_conversion.hero.miles_hour")],
    ["knots", t("tools.unit_conversion.hero.knots")],
  ]},
  { group: t("tools.unit_conversion.hero.group_area"), options: [
    ["m2", t("tools.unit_conversion.hero.square_meters")],
    ["km2", t("tools.unit_conversion.hero.square_kilometers")],
    ["ft2", t("tools.unit_conversion.hero.square_feet")],
    ["acre", t("tools.unit_conversion.hero.acres")],
    ["ha", t("tools.unit_conversion.hero.hectares")],
  ]},
] %>

<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      <%= t("tools.unit_conversion.hero.title_html").html_safe %>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      <%= t("tools.unit_conversion.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t("tools.unit_conversion.hero.get_api_key"),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t("tools.unit_conversion.hero.read_the_docs"),
            variant: "outline",
            href: api_path("unit-conversion"),
            size: "lg" %>
    </div>

    <div class="mt-12 max-w-xl mx-auto"
         data-controller="unit-conversion-demo"
         data-unit-conversion-demo-error-fill-all-fields-value="<%= t('tools.unit_conversion.demo.error_fill_all_fields') %>">

      <form data-action="turbo:submit-start->unit-conversion-demo#onSubmitStart turbo:submit-end->unit-conversion-demo#onSubmitEnd"
            action="<%= tool_demo_unit_conversion_path %>"
            method="post"
            data-turbo-frame="unit_conversion-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex flex-col gap-2">

          <label for="unit-conversion-from-demo-input" class="sr-only"><%= t("tools.unit_conversion.hero.source_unit") %></label>
          <select
            id="unit-conversion-from-demo-input"
            name="from"
            data-unit-conversion-demo-target="from"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
            <option value=""><%= t("tools.unit_conversion.hero.source_unit") %></option>
            <% unit_options.each do |group| %>
              <optgroup label="<%= group[:group] %>">
                <% group[:options].each do |value, label| %>
                  <option value="<%= value %>" <%= "selected" if value == "m" %>><%= label %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>

          <label for="unit-conversion-to-demo-input" class="sr-only"><%= t("tools.unit_conversion.hero.target_unit") %></label>
          <select
            id="unit-conversion-to-demo-input"
            name="to"
            data-unit-conversion-demo-target="to"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
            <option value=""><%= t("tools.unit_conversion.hero.target_unit") %></option>
            <% unit_options.each do |group| %>
              <optgroup label="<%= group[:group] %>">
                <% group[:options].each do |value, label| %>
                  <option value="<%= value %>" <%= "selected" if value == "km" %>><%= label %></option>
                <% end %>
              </optgroup>
            <% end %>
          </select>

          <label for="unit-conversion-value-demo-input" class="sr-only"><%= t("tools.unit_conversion.demo.value_label") %></label>
          <input
            id="unit-conversion-value-demo-input"
            type="number"
            name="value"
            data-unit-conversion-demo-target="value"
            placeholder="<%= t('tools.unit_conversion.demo.input_placeholder') %>"
            autocomplete="off"
            class="no-spinner flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          />

          <div class="flex justify-between">
            <p class="mt-2 flex text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("shared.info.no_account_demo") %></p>
            <%= render "partials/shared/submit_button", text: t("tools.unit_conversion.hero.convert"), controller: "unit-conversion-demo" %>
          </div>
        </div>

        <p data-unit-conversion-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="unit_conversion-demo-result"></turbo-frame>
    </div>

  </div>
</section>
