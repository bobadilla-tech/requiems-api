<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid md:grid-cols-2 gap-12">

      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-primary text-white mb-4"><%= t("shared.headings.accuracy") %></span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("tools.unit_conversion.what_it_does.reliable_conversions_with_transparent") %></h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            Convert between length, weight, volume, temperature, area, and speed units with consistent results. Every response includes the converted value and a human-readable formula so you can verify exactly how the calculation was performed.
          </p>
        </div>

        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "from": "miles",
  "to": "km",
  "input": 10,
  "result": 16.09344,
  "formula": "10 × 1.609344"
}
        <% end %>
      </div>

      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 mb-4"><%= t("shared.headings.simplicity") %></span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t("tools.unit_conversion.what_it_does.simple_api_requests_instant_results") %></h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            Pass a source unit, target unit, and numeric value in a simple JSON payload.
            No configuration, no external dependencies, and no lookup tables required.
            The API returns the converted value and the conversion formula in a single response.
          </p>
        </div>

        <%= render "partials/tools/shared/code_sample", language: "http" do %>
POST /v1/technology/convert
Host: api.requiems.xyz
requiems-api-key: YOUR_API_KEY
Content-Type: application/json

{"from": "miles", "to": "km", "value": 10}
        <% end %>
      </div>

    </div>

  </div>
</section>
