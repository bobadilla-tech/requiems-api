            &nbsp;&nbsp;<span class="text-sky-300">"from"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"miles"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"to"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"km"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"input"</span><span class="text-gray-500">:</span> <span class="text-purple-400">10</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"result"</span><span class="text-gray-500">:</span> <span class="text-purple-400">16.09344</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"formula"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"10 × 1.609344"</span><br>
            <span class="text-gray-500">}</span>
