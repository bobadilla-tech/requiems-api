<% faqs = [
  {
    q: "What units can I convert?",
    a: "The API supports conversions across length, weight, volume, temperature, area, and speed. Examples include miles to kilometers, kilograms to pounds, liters to gallons, Celsius to Fahrenheit, square meters to square feet, and more."
  },
  {
    q: "How accurate are the conversions?",
    a: "Conversions use standardized conversion factors and return results rounded to 6 decimal places. The response also includes the exact formula used for transparency and verification."
  },
  {
    q: "What happens if I try to convert incompatible units?",
    a: "The API returns a 400 Bad Request error with a descriptive message. For example, converting kilograms to kilometers returns: 'incompatible units: cannot convert between different measurement types'."
  },
  {
    q: "Which measurement categories are supported?",
    a: "The API supports length, weight, volume, temperature, area, and speed conversions. Each category includes multiple units and aliases, making it easy to work with real-world user input."
  },
  {
    q: "Does the response include the conversion formula?",
    a: "Yes. Every successful conversion returns a human-readable formula alongside the converted value, making calculations easy to verify and display in your application."
  },
  {
    q: "Is it free to use?",
    a: "The demo above works without an account. Production usage requires an API key and is subject to your plan's rate limits."
  }
] %>

<section class="bg-white dark:bg-gray-900 py-20">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t('tools.email_normalizer.faq.heading') %></h2>


    </div>

    <div class="space-y-3" data-controller="faq-accordion">
      <% faqs.each_with_index do |faq, i| %>
        <% panel_id = "unit-conversion-faq-#{i}" %>
        <% button_id = "#{panel_id}-button" %>

        <div class="rounded-xl border border-gray-200 dark:border-gray-700 overflow-hidden">
          <button type="button"
                  id="<%= button_id %>"
                  class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors"
                  data-action="click->faq-accordion#toggle"
                  data-faq-accordion-target="button"
                  aria-expanded="false"
                  aria-controls="<%= panel_id %>">
            <span class="font-medium text-gray-900 dark:text-gray-100">
              <%= faq[:q] %>
            </span>

            <svg class="h-5 w-5 shrink-0 text-gray-400 transition-transform ml-4"
                 fill="none"
                 stroke="currentColor"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
              <path stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"/>
            </svg>
          </button>

          <div id="<%= panel_id %>"
               class="hidden px-6 pb-5 text-gray-500 dark:text-gray-400 text-sm leading-relaxed"
               role="region"
               aria-labelledby="<%= button_id %>"
               data-faq-accordion-target="content">
            <%= faq[:a] %>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>
