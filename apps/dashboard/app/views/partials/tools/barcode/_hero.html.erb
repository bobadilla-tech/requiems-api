<%#
  Type option values MUST match what the Barcode API accepts:
  code128, code93, code39, ean8, ean13.
%>
<% barcode_type_options = [
  ["code128", t("tools.barcode.hero.type_code128")],
  ["code93",  t("tools.barcode.hero.type_code93")],
  ["code39",  t("tools.barcode.hero.type_code39")],
  ["ean8",    t("tools.barcode.hero.type_ean8")],
  ["ean13",   t("tools.barcode.hero.type_ean13")],
] %>

<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      <%= t("tools.barcode.hero.title") %>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      <%= t("tools.barcode.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t("tools.barcode.hero.cta_primary"),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t("tools.barcode.hero.cta_docs"),
            variant: "outline",
            href: api_path("barcode"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="barcode-demo"
         data-barcode-demo-error-empty-value="<%= t('tools.barcode.demo.error_empty') %>">

      <form data-action="turbo:submit-start->barcode-demo#onSubmitStart turbo:submit-end->barcode-demo#onSubmitEnd"
            action="<%= tool_demo_barcode_path %>"
            method="post"
            data-turbo-frame="barcode-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex flex-col sm:flex-row gap-2">
          <label for="barcode-demo-data" class="sr-only"><%= t("tools.barcode.hero.label_data") %></label>
          <input
            id="barcode-demo-data"
            type="text"
            name="data"
            data-barcode-demo-target="input"
            placeholder="<%= t('tools.barcode.hero.placeholder_data') %>"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
          <label for="barcode-demo-type" class="sr-only"><%= t("tools.barcode.hero.label_type") %></label>
          <select
            id="barcode-demo-type"
            name="type"
            data-barcode-demo-target="select"
            class="block w-full sm:w-40 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-3 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
            <% barcode_type_options.each do |value, label| %>
              <option value="<%= value %>" <%= "selected" if value == "code128" %>><%= label %></option>
            <% end %>
          </select>
          <%= render "partials/shared/submit_button", text: t("tools.barcode.hero.submit"), controller: "barcode-demo" %>
        </div>

        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("tools.barcode.hero.no_account") %></p>

        <p data-barcode-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="barcode-demo-result"></turbo-frame>
    </div>

  </div>
</section>
