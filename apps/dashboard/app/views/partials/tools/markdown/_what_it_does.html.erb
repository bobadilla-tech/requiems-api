<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("tools.markdown.what_it_does.heading") %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t("tools.markdown.what_it_does.subtitle") %></p>
    </div>
    <div class="grid md:grid-cols-2 gap-8">
      <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 dark:bg-blue-900 dark:text-blue-300 mb-4">
          <%= t("tools.markdown.what_it_does.commonmark_badge") %>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2"><%= t("tools.markdown.what_it_does.commonmark_title") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">
          <%= t("tools.markdown.what_it_does.commonmark_body") %>
        </p>
        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "markdown": "# Hello\n\n**Bold** and _italic_.",
  "sanitize": false
}
        <% end %>
      </div>
      <div class="bg-white dark:bg-gray-900 rounded-2xl p-8 shadow-sm">
        <div class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300 mb-4">
          <%= t("tools.markdown.what_it_does.sanitize_badge") %>
        </div>
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2"><%= t("tools.markdown.what_it_does.sanitize_title") %></h3>
        <p class="text-gray-500 dark:text-gray-400 text-sm mb-6">
          <%= t("tools.markdown.what_it_does.sanitize_body") %>
        </p>
        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "data": {
    "html": "<h1>Hello</h1>\n<p><strong>Bold</strong> and <em>italic</em>.</p>"
  }
}
        <% end %>
      </div>
    </div>
  </div>
</section>
