<% cards = [
  {
    icon: "📄",
    title: t('tools.markdown.use_cases.docs_title'),
    body: t('tools.markdown.use_cases.docs_body')
  },
  {
    icon: "✍️",
    title: t('tools.markdown.use_cases.editor_title'),
    body: t('tools.markdown.use_cases.editor_body')
  },
  {
    icon: "📧",
    title: t('tools.markdown.use_cases.email_title'),
    body: t('tools.markdown.use_cases.email_body')
  },
  {
    icon: "🤖",
    title: t('tools.markdown.use_cases.ai_title'),
    body: t('tools.markdown.use_cases.ai_body')
  },
  {
    icon: "🏗️",
    title: t('tools.markdown.use_cases.static_title'),
    body: t('tools.markdown.use_cases.static_body')
  },
  {
    icon: "🔒",
    title: t('tools.markdown.use_cases.ugc_title'),
    body: t('tools.markdown.use_cases.ugc_body')
  }
] %>
<section class="bg-white dark:bg-gray-900 py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t('tools.markdown.use_cases.heading') %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t('tools.markdown.use_cases.subheading') %></p>
    </div>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% cards.each do |card| %>
        <div class="rounded-2xl border border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-800 p-6">
          <div class="text-3xl mb-3"><%= card[:icon] %></div>
          <h3 class="font-semibold text-gray-900 dark:text-white mb-1"><%= card[:title] %></h3>
          <p class="text-sm text-gray-500 dark:text-gray-400"><%= card[:body] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>
