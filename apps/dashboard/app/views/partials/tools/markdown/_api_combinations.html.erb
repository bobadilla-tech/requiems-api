<% combos = [
  {
    title: t('tools.markdown.api_combinations.spell_check_title'),
    body: t('tools.markdown.api_combinations.spell_check_body'),
    link_text: t('tools.markdown.api_combinations.spell_check_link'),
    link_id: "spell-check"
  },
  {
    title: t('tools.markdown.api_combinations.profanity_title'),
    body: t('tools.markdown.api_combinations.profanity_body'),
    link_text: t('tools.markdown.api_combinations.profanity_link'),
    link_id: "profanity-filter"
  },
  {
    title: t('tools.markdown.api_combinations.sentiment_title'),
    body: t('tools.markdown.api_combinations.sentiment_body'),
    link_text: t('tools.markdown.api_combinations.sentiment_link'),
    link_id: "sentiment"
  }
] %>
<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t('tools.markdown.api_combinations.heading') %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t('tools.markdown.api_combinations.subheading') %></p>
    </div>
    <div class="grid md:grid-cols-3 gap-6">
      <% combos.each do |combo| %>
        <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100 dark:border-gray-700 p-6 flex flex-col">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2"><%= combo[:title] %></h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 flex-1"><%= combo[:body] %></p>
          <%= link_to api_path(combo[:link_id]),
                class: "mt-4 text-sm font-medium inline-flex items-center gap-1 text-brand-primary" do %>
            <%= combo[:link_text] %>
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</section>
