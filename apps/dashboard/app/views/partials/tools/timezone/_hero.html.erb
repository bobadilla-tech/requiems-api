<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      <%= t("tools.timezone.hero.title") %>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      <%= t("tools.timezone.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t("tools.timezone.hero.cta_primary"),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t("tools.timezone.hero.cta_docs"),
            variant: "outline",
            href: api_path("timezone"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="timezone-demo"
         data-timezone-demo-error-empty-value="<%= t('tools.timezone.demo.error_empty') %>">

      <form data-action="turbo:submit-start->timezone-demo#onSubmitStart turbo:submit-end->timezone-demo#onSubmitEnd"
            action="<%= tool_demo_timezone_path %>"
            method="post"
            data-turbo-frame="timezone-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex gap-2">
          <label for="timezone-demo-input" class="sr-only"><%= t("tools.timezone.hero.label_input") %></label>
          <input
            id="timezone-demo-input"
            type="text"
            name="city"
            data-timezone-demo-target="input"
            data-action="input->timezone-demo#onCityInput"
            placeholder="<%= t('tools.timezone.hero.placeholder') %>"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-gray-100 dark:disabled:bg-gray-900"
          >
          <%= render "partials/shared/submit_button", text: t("tools.timezone.hero.submit"), controller: "timezone-demo" %>
        </div>

        <p class="mt-3 mb-2 text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("tools.timezone.hero.coords_divider") %></p>

        <div class="flex gap-2">
          <div class="flex-1">
            <label for="timezone-demo-lat" class="sr-only"><%= t("tools.timezone.hero.label_lat") %></label>
            <input
              id="timezone-demo-lat"
              type="number"
              step="any"
              min="-90"
              max="90"
              name="lat"
              data-timezone-demo-target="lat"
              data-action="input->timezone-demo#onCoordsInput"
              placeholder="<%= t('tools.timezone.hero.placeholder_lat') %>"
              autocomplete="off"
              class="block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-gray-100 dark:disabled:bg-gray-900"
            >
          </div>
          <div class="flex-1">
            <label for="timezone-demo-lon" class="sr-only"><%= t("tools.timezone.hero.label_lon") %></label>
            <input
              id="timezone-demo-lon"
              type="number"
              step="any"
              min="-180"
              max="180"
              name="lon"
              data-timezone-demo-target="lon"
              data-action="input->timezone-demo#onCoordsInput"
              placeholder="<%= t('tools.timezone.hero.placeholder_lon') %>"
              autocomplete="off"
              class="block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm disabled:opacity-50 disabled:cursor-not-allowed disabled:bg-gray-100 dark:disabled:bg-gray-900"
            >
          </div>
        </div>

        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("tools.timezone.hero.no_account") %></p>

        <p data-timezone-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="timezone-demo-result"></turbo-frame>
    </div>

  </div>
</section>
