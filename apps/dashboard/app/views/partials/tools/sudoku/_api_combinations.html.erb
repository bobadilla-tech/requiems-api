<section class="bg-gray-50 dark:bg-gray-950 py-16 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100">
        <%= t("tools.sudoku.api_combinations.heading") %>
      </h2>
      <p class="mt-3 text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
        <%= t("tools.sudoku.api_combinations.subheading") %>
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <% [
        { name:    t("tools.sudoku.api_combinations.trivia_name"),
          benefit: t("tools.sudoku.api_combinations.trivia_benefit"),
          outcome: t("tools.sudoku.api_combinations.trivia_outcome"),
          href:    api_path("trivia") },
        { name:    t("tools.sudoku.api_combinations.quotes_name"),
          benefit: t("tools.sudoku.api_combinations.quotes_benefit"),
          outcome: t("tools.sudoku.api_combinations.quotes_outcome"),
          href:    api_path("quotes") },
        { name:    t("tools.sudoku.api_combinations.qr_name"),
          benefit: t("tools.sudoku.api_combinations.qr_benefit"),
          outcome: t("tools.sudoku.api_combinations.qr_outcome"),
          href:    api_path("qr-code") },
      ].each do |combo| %>
        <a href="<%= combo[:href] %>" class="block bg-white dark:bg-gray-800 rounded-xl p-5 border border-gray-200 dark:border-gray-700 hover:shadow-md transition-shadow no-underline">
          <h3 class="text-sm font-bold text-gray-900 dark:text-gray-100 mb-3">
            <%= combo[:name] %>
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">
            <span class="font-medium text-gray-700 dark:text-gray-300"><%= t("tools.sudoku.api_combinations.label_benefit") %></span>
            <%= combo[:benefit] %>
          </p>
          <p class="text-sm text-gray-600 dark:text-gray-400">
            <span class="font-medium text-gray-700 dark:text-gray-300"><%= t("tools.sudoku.api_combinations.label_outcome") %></span>
            <%= combo[:outcome] %>
          </p>
        </a>
      <% end %>
    </div>
  </div>
</section>
