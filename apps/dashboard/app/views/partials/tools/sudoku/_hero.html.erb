<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      <%= t("tools.sudoku.hero.title") %>
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      <%= t("tools.sudoku.hero.subtitle") %>
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t("tools.sudoku.hero.cta_primary"),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t("tools.sudoku.hero.cta_docs"),
            variant: "outline",
            href: api_path("sudoku"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="sudoku-demo"
         data-sudoku-demo-error-empty-value="<%= t('tools.sudoku.demo.error_empty') %>">

      <form data-action="turbo:submit-start->sudoku-demo#onSubmitStart turbo:submit-end->sudoku-demo#onSubmitEnd"
            action="<%= tool_demo_sudoku_path %>"
            method="post"
            data-turbo-frame="sudoku-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>

        <div class="flex flex-col sm:flex-row gap-2">
          <div class="flex-1 text-left">
            <label for="sudoku-demo-difficulty" class="sr-only"><%= t("tools.sudoku.hero.label_difficulty") %></label>
            <select id="sudoku-demo-difficulty"
                    name="difficulty"
                    data-sudoku-demo-target="input"
                    class="block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm">
              <option value="easy"><%= t("tools.sudoku.hero.difficulty_easy") %></option>
              <option value="medium" selected><%= t("tools.sudoku.hero.difficulty_medium") %></option>
              <option value="hard"><%= t("tools.sudoku.hero.difficulty_hard") %></option>
            </select>
          </div>

          <%= render "partials/shared/submit_button", text: t("tools.sudoku.hero.submit"), controller: "sudoku-demo" %>
        </div>

        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-left"><%= t("tools.sudoku.hero.no_account") %></p>

        <p data-sudoku-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="sudoku-demo-result"></turbo-frame>
    </div>

  </div>
</section>
