<% use_cases = [
  {
    title:   "Prevent high-bounce campaigns",
    desc:    "Verify imported lists before launching any sequence. Bounce spikes tank deliverability for every future send.",
    tags:    ["Marketing", "Email campaigns"]
  },
  {
    title:   "Stop fake signups at source",
    desc:    "Real-time form validation blocks bots and throwaway emails before they inflate your subscriber count.",
    tags:    ["Growth", "Signup flows"]
  },
  {
    title:   "Keep CRM data clean",
    desc:    "Regular validation ensures your contact base reflects real people, not dead addresses.",
    tags:    ["Operations", "CRM"]
  },
  {
    title:   "Trust your open rate metrics",
    desc:    "Accurate lists make analytics reflect actual recipients, not bounces.",
    tags:    ["Analytics", "Email marketing"]
  },
  {
    title:   "Block disposable addresses",
    desc:    "Catch throwaway domains before they reduce your sender reputation.",
    tags:    ["Security", "Fraud prevention"]
  },
  {
    title:   "Catch typos instantly",
    desc:    "Spot gmial.com or outlok.com at entry and prompt a correction before the user moves on.",
    tags:    ["Conversion", "Checkout forms"]
  }
] %>

<section class="bg-white dark:bg-gray-900 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t('tools.email_normalizer.use_cases.heading') %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t('tools.email_validator.use_cases.email_validator_fits_wherever_contact') %></p>


    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% use_cases.each do |uc| %>
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 hover:shadow-md transition-shadow">
          <h3 class="font-semibold text-gray-900 dark:text-white mb-2"><%= uc[:title] %></h3>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed mb-4"><%= uc[:desc] %></p>
          <div class="flex flex-wrap gap-2">
            <% uc[:tags].each do |tag| %>
              <span class="text-xs px-2 py-0.5 rounded-full bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300">
                <%= tag %>
              </span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

  </div>
</section>
