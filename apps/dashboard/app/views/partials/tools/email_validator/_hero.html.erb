<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      Know if an email is real<br class="hidden sm:block"> before you send.
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto"><%= t('tools.email_validator.hero.syntax_check_live_mx_lookup_disposable') %></p>



    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: t('tools.email_validator.hero.get_api_key'),
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: t('tools.email_validator.hero.read_the_docs'),
            variant: "outline",
            href: api_path("email-validate"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="email-validator-demo"
         data-email-validator-demo-error-empty-value="<%= t('tools.email_validator.demo.error_empty') %>">

      <form data-action="submit->email-validator-demo#beforeSubmit turbo:submit-start->email-validator-demo#onSubmitStart turbo:submit-end->email-validator-demo#onSubmitEnd"
            action="<%= tool_demo_email_validator_path %>"
            method="post"
            data-turbo-frame="email_validator-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex gap-2">
          <label for="email-validator-demo-input" class="sr-only"><%= t('auth.sign_in.email') %></label>
          <input
            id="email-validator-demo-input"
            type="email"
            name="email"
            data-email-validator-demo-target="input"
            placeholder="<%= t('shared.email_input_placeholder') %>"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
          <%= render "partials/shared/submit_button", text: t('tools.email_validator.hero.verify'), controller: "email-validator-demo" %>
        </div>

        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-left"><%= t('shared.no_account_demo') %></p>

        <p data-email-validator-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="email_validator-demo-result"></turbo-frame>
    </div>

  </div>
</section>
