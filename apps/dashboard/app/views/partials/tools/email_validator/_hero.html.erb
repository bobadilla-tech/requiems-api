<section class="bg-white dark:bg-gray-900 pt-20 pb-16">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">

    <h1 class="text-4xl sm:text-5xl font-bold tracking-tight text-gray-900 dark:text-white leading-tight">
      Know if an email is real<br class="hidden sm:block"> before you send.
    </h1>

    <p class="mt-5 text-lg sm:text-xl text-gray-500 dark:text-gray-400 max-w-2xl mx-auto">
      Syntax check, live MX lookup, disposable detection, and typo correction — in a single API call.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
      <%= render "partials/shared/button",
            text: "Get API Key",
            variant: "brand",
            href: new_user_registration_path,
            size: "lg" %>
      <%= render "partials/shared/button",
            text: "Read the docs",
            variant: "outline",
            href: api_path("email-validate"),
            size: "lg" %>
    </div>

    <!-- Live demo -->
    <div class="mt-12 max-w-xl mx-auto"
         data-controller="email-validator-demo"
         data-email-validator-demo-error-empty-value="<%= t('tools.email_validator.demo.error_empty') %>">

      <form data-action="submit->email-validator-demo#beforeSubmit turbo:submit-start->email-validator-demo#onSubmitStart turbo:submit-end->email-validator-demo#onSubmitEnd"
            action="<%= tool_demo_email_validator_path %>"
            method="post"
            data-turbo-frame="email_validator-demo-result"
            novalidate>
        <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
        <div class="flex gap-2">
          <label for="email-validator-demo-input" class="sr-only">Email address</label>
          <input
            id="email-validator-demo-input"
            type="email"
            name="email"
            data-email-validator-demo-target="input"
            placeholder="Enter any email address"
            autocomplete="off"
            class="flex-1 block w-full rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 px-4 py-3 text-gray-900 dark:text-gray-100 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-brand-primary focus:border-transparent text-sm"
          >
          <button
            type="submit"
            data-email-validator-demo-target="button"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-brand-primary text-white font-semibold text-sm transition-colors disabled:opacity-60"
          >
            <span data-email-validator-demo-target="spinner" class="hidden">
              <svg class="animate-spin h-4 w-4" fill="none" viewBox="0 0 24 24" aria-hidden="true">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
              </svg>
            </span>
            Verify
          </button>
        </div>

        <p class="mt-2 text-xs text-gray-400 dark:text-gray-500 text-left">No account required for the demo.</p>

        <p data-email-validator-demo-target="errorMessage"
           class="hidden mt-2 text-sm text-red-500 text-left"
           role="alert"></p>
      </form>

      <turbo-frame id="email_validator-demo-result"></turbo-frame>
    </div>

  </div>
</section>
