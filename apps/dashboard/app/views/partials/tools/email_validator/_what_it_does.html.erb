<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid md:grid-cols-2 gap-12">

      <!-- Block A: Accuracy -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-primary text-white mb-4"><%= t('shared.headings.accuracy') %></span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t('tools.email_validator.what_it_does.accurate_and_fast_every_single_check') %></h2>


          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            Email Validator runs a full breakdown on every address: RFC&nbsp;5322 syntax, live MX record lookup, disposable domain detection across 90,000+ domains, normalization, and typo suggestion for common providers.
          </p>
        </div>

        <!-- Mock response card -->
        <div class="rounded-xl bg-gray-900 dark:bg-gray-950 p-5 font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 mb-2 text-[11px]"><%= t('tools.email_validator.what_it_does.post_v1_validation_email_200_ok') %></div>
          <div>
            <span class="text-gray-500">{</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"email"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"user@gmial.com"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"valid"</span><span class="text-gray-500">:</span> <span class="text-purple-400">false</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"syntax_valid"</span><span class="text-gray-500">:</span> <span class="text-purple-400">true</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"mx_valid"</span><span class="text-gray-500">:</span> <span class="text-purple-400">false</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"disposable"</span><span class="text-gray-500">:</span> <span class="text-purple-400">false</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"normalized"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"user@gmial.com"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"domain"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"gmial.com"</span><span class="text-gray-500">,</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"suggestion"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"gmail.com"</span><br>
            <span class="text-gray-500">}</span>
          </div>
        </div>
      </div>

      <!-- Block B: Simplicity -->
      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 mb-4"><%= t('shared.headings.simplicity') %></span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white"><%= t('tools.email_validator.what_it_does.fast_uncomplicated_easy_to_integrate') %></h2>


          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            One POST request with a single email or up to 50 in batch. Your API key in the header. No SDK, no setup, no dependencies. The response tells you exactly what to do.
          </p>
        </div>

        <!-- Mock request card -->
        <div class="rounded-xl bg-gray-900 dark:bg-gray-950 p-5 font-mono text-xs leading-relaxed overflow-x-auto">
          <div class="text-gray-500 mb-2 text-[11px]"><%= t('systems.show.request_label') %></div>
          <div>
            <span class="text-sky-300">POST</span> <span class="text-gray-300">/v1/validation/email</span><br><br>
            <span class="text-gray-500"># Headers</span><br>
            <span class="text-sky-300">requiems-api-key</span><span class="text-gray-500">:</span> <span class="text-amber-300">YOUR_API_KEY</span><br>
            <span class="text-sky-300">Content-Type</span><span class="text-gray-500">:</span> <span class="text-amber-300">application/json</span><br><br>
            <span class="text-gray-500"># Body</span><br>
            <span class="text-gray-500">{</span><br>
            &nbsp;&nbsp;<span class="text-sky-300">"email"</span><span class="text-gray-500">:</span> <span class="text-amber-300">"user@example.com"</span><br>
            <span class="text-gray-500">}</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
