<% combinations = [
  {
    pair:    "Email Validator + Phone Validator",
    benefit: "Verify both email and phone at signup, reducing fake accounts and improving lead quality.",
    href:    "/apis/phone-validation"
  },
  {
    pair:    "Email Validator + IP Reputation",
    benefit: "Catch risky signups by validating contact data and blocking suspicious traffic in one flow.",
    href:    "/apis/identity-risk"
  },
  {
    pair:    "Email Validator + Address Formatter",
    benefit: "Combine email validation with postal normalization for clean contact records across CRM and delivery workflows.",
    href:    "/apis/global-data"
  }
] %>

<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t('tools.email_validator.api_combinations.heading') %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto"><%= t('tools.email_validator.api_combinations.email_validator_works_even_better_when') %></p>


    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      <% combinations.each do |c| %>
        <div class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 hover:shadow-md transition-shadow">
          <div class="font-semibold text-gray-900 dark:text-white mb-3 leading-snug">
            <%= c[:pair] %>
          </div>
          <p class="text-sm text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= c[:benefit] %>
          </p>
        </div>
      <% end %>
    </div>

  </div>
</section>
