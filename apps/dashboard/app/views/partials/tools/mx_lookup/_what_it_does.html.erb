<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

    <div class="grid md:grid-cols-2 gap-12">

      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-brand-primary text-white mb-4">
            <%= t("tools.mx_lookup.what_it_does.records_badge") %>
          </span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.mx_lookup.what_it_does.records_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.mx_lookup.what_it_does.records_body") %>
          </p>
        </div>

        <%= render "partials/tools/shared/code_sample", language: "json" do %>
{
  "domain": "gmail.com",
  "records": [
    { "host": "gmail-smtp-in.l.google.com.", "priority": 5 },
    { "host": "alt1.gmail-smtp-in.l.google.com.", "priority": 10 },
    { "host": "alt2.gmail-smtp-in.l.google.com.", "priority": 20 }
  ]
}
        <% end %>
      </div>

      <div class="flex flex-col gap-6">
        <div>
          <span class="inline-block text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full bg-blue-100 dark:bg-blue-900 text-blue-700 dark:text-blue-300 mb-4">
            <%= t("tools.mx_lookup.what_it_does.simplicity_badge") %>
          </span>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white">
            <%= t("tools.mx_lookup.what_it_does.simplicity_heading") %>
          </h2>
          <p class="mt-3 text-gray-500 dark:text-gray-400 leading-relaxed">
            <%= t("tools.mx_lookup.what_it_does.simplicity_body") %>
          </p>
        </div>

        <%= render "partials/tools/shared/code_sample", language: "http" do %>
GET /v1/networking/mx/gmail.com
Host: requiems.xyz
requiems-api-key: YOUR_API_KEY
        <% end %>
      </div>

    </div>
  </div>
</section>
