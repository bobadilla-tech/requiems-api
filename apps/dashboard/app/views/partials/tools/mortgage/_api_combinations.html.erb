<section class="bg-gray-50 dark:bg-gray-800 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-12">
      <h2 class="text-3xl font-bold text-gray-900 dark:text-white"><%= t("tools.mortgage.api_combinations.heading") %></h2>
      <p class="mt-3 text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        <%= t("tools.mortgage.api_combinations.subheading") %>
      </p>
    </div>
    <div class="grid sm:grid-cols-3 gap-6">
      <% [
        { pair:    t("tools.mortgage.api_combinations.inflation_pair"),
          benefit: t("tools.mortgage.api_combinations.inflation_benefit"),
          outcome: t("tools.mortgage.api_combinations.inflation_outcome"),
          href:    "/apis/inflation" },
        { pair:    t("tools.mortgage.api_combinations.currency_pair"),
          benefit: t("tools.mortgage.api_combinations.currency_benefit"),
          outcome: t("tools.mortgage.api_combinations.currency_outcome"),
          href:    "/apis/currency" },
        { pair:    t("tools.mortgage.api_combinations.random_user_pair"),
          benefit: t("tools.mortgage.api_combinations.random_user_benefit"),
          outcome: t("tools.mortgage.api_combinations.random_user_outcome"),
          href:    "/apis/random-user" },
      ].each do |c| %>
        <a href="<%= c[:href] %>" class="block rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-6 hover:shadow-md transition-shadow no-underline">
          <div class="font-semibold text-gray-900 dark:text-white mb-2 leading-snug"><%= c[:pair] %></div>
          <p class="text-xs text-gray-500 dark:text-gray-400 mb-1">
            <span class="font-medium"><%= t("tools.mortgage.api_combinations.label_benefit") %></span> <%= c[:benefit] %>
          </p>
          <p class="text-xs text-gray-500 dark:text-gray-400">
            <span class="font-medium"><%= t("tools.mortgage.api_combinations.label_outcome") %></span> <%= c[:outcome] %>
          </p>
        </a>
      <% end %>
    </div>
  </div>
</section>
