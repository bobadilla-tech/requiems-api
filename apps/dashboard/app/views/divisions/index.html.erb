<% content_for :title, t("divisions.index.meta_title") %>
<% i18n_scope = "divisions.index" %>

<%= render "partials/divisions/hero", i18n_scope: i18n_scope %>
<%= render "partials/divisions/tagline", i18n_scope: i18n_scope %>

<section class="py-14 bg-gray-50 dark:bg-gray-950">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
      <% @division_slugs.each do |slug| %>
        <% card_scope = "divisions.index.cards.#{slug}" %>
        <%= link_to division_path(slug), class: "group block rounded-2xl border border-gray-200 dark:border-gray-800 bg-white dark:bg-gray-900 p-6 shadow-sm hover:shadow-md hover:border-blue-300 dark:hover:border-blue-600 transition-all" do %>
          <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl <%= category_color_classes(slug, hover: true) %>">
            <%= category_icon_svg(slug, size: "w-7 h-7") %>
          </div>
          <h2 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400">
            <%= t("#{card_scope}.title") %>
          </h2>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4">
            <%= t("#{card_scope}.blurb") %>
          </p>
          <span class="text-sm font-semibold text-blue-600 dark:text-blue-400 inline-flex items-center">
            <%= t("divisions.index.view_division") %>
            <svg class="ml-1 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </span>
        <% end %>
      <% end %>
    </div>
  </div>
</section>

<section class="py-14 bg-white dark:bg-gray-900 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    <div class="rounded-2xl border border-gray-200 bg-gray-50/80 dark:border-gray-700 dark:bg-gray-800/50 px-6 py-10 sm:px-10 sm:py-12 text-center shadow-sm">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900 dark:text-gray-100 mb-3">
        <%= t("divisions.index.apis_catalog_title") %>
      </h2>
      <p class="text-base text-gray-600 dark:text-gray-300 max-w-2xl mx-auto mb-8 leading-relaxed">
        <%= t("divisions.index.apis_catalog_subtitle") %>
      </p>
      <%= link_to apis_path,
                  class: "inline-flex items-center justify-center rounded-xl bg-blue-600 px-6 py-3 text-base font-semibold text-white shadow-md transition-colors hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2 dark:focus-visible:ring-offset-gray-900" do %>
        <%= t("divisions.index.apis_catalog_cta") %>
        <svg class="ml-2 h-5 w-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      <% end %>
    </div>
  </div>
</section>

<section class="py-16 bg-gray-50 dark:bg-gray-950 border-t border-gray-200 dark:border-gray-800">
  <div class="max-w-xl mx-auto px-4 text-center">
    <p class="text-base text-gray-600 dark:text-gray-400 mb-6">Still have questions? Let's talk through your use case.</p>
    <%= link_to cal_com_strategy_url, target: "_blank", rel: "noopener noreferrer",
                class: "inline-flex items-center justify-center gap-2 px-6 py-3 rounded-lg font-semibold border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors" do %>
      <%= t("divisions.index.strategy_call.label") %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
      </svg>
    <% end %>
  </div>
</section>
