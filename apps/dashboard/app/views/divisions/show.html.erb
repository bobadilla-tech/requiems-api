<% i18n_scope = "divisions.#{@slug}" %>
<% content_for :title, t("#{i18n_scope}.meta_title") %>
<% vc = t("#{i18n_scope}.view_case") %>

<div data-controller="division-hub">
  <%= render "partials/divisions/hero", i18n_scope: i18n_scope %>
  <%= render "partials/divisions/tagline", i18n_scope: i18n_scope, hub_page: true %>
  <%= render "partials/divisions/carousel", i18n_scope: i18n_scope, view_case_label: vc %>
  <%= render "partials/divisions/use_case_grid", i18n_scope: i18n_scope, view_case_label: vc %>
</div>

<%= render "partials/divisions/scale_metrics", i18n_scope: i18n_scope %>
<%= render "partials/divisions/how_it_works", i18n_scope: i18n_scope %>
<%= render "partials/divisions/ux_flow" %>
<%= render "partials/divisions/industries", i18n_scope: i18n_scope %>
<%= render "partials/divisions/testimonials", i18n_scope: i18n_scope %>
<%= render "partials/divisions/final_cta", i18n_scope: i18n_scope %>
<%= render "partials/divisions/technical_link", slug: @slug %>
