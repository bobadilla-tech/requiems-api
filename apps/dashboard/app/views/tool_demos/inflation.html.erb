<turbo-frame id="inflation-demo-result">
  <div class="mt-4 text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden">

    <!-- Header: country + current rate -->
    <div class="px-4 py-4 bg-gray-50 dark:bg-gray-900 flex items-center justify-between gap-3">
      <div>
        <span class="text-xs font-mono text-gray-500 dark:text-gray-400 uppercase tracking-wide"><%= data["country"] %></span>
        <p class="mt-0.5 text-2xl font-bold text-gray-900 dark:text-white">
          <%= number_with_precision(data["rate"], precision: 2) %>%
        </p>
        <p class="text-xs text-gray-400 dark:text-gray-500"><%= t("tools.inflation.demo.label_annual_cpi") %> <%= data["period"] %></p>
      </div>
      <span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">
        <%= t("tools.inflation.demo.badge_live") %>
      </span>
    </div>

    <!-- Historical table -->
    <% if data["historical"].present? %>
      <div class="px-4 py-3">
        <p class="text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wide mb-2">
          <%= t("tools.inflation.demo.label_historical") %>
        </p>
        <div class="divide-y divide-gray-100 dark:divide-gray-700">
          <% data["historical"].first(5).each do |entry| %>
            <div class="flex items-center justify-between py-1.5">
              <span class="text-sm text-gray-500 dark:text-gray-400"><%= entry["period"] %></span>
              <span class="text-sm font-medium text-gray-800 dark:text-gray-200">
                <%= number_with_precision(entry["rate"], precision: 2) %>%
              </span>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>

  </div>
</turbo-frame>
