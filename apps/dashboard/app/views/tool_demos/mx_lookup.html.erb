<%
  records = data["records"] || []
%>
<turbo-frame id="mx_lookup-demo-result">
  <div class="mt-4 text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden">

    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center gap-2">
      <span class="text-xs font-mono text-gray-500 dark:text-gray-400 truncate"><%= data["domain"] %></span>
      <span class="ml-auto shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">
        <%= t("tools.mx_lookup.demo.badge_records_found", count: records.size) %>
      </span>
    </div>

    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-gray-100 dark:border-gray-700 bg-gray-50 dark:bg-gray-900">
          <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider w-16">
            <%= t("tools.mx_lookup.demo.label_priority") %>
          </th>
          <th class="px-4 py-2 text-left text-xs font-semibold text-gray-500 dark:text-gray-400 uppercase tracking-wider">
            <%= t("tools.mx_lookup.demo.label_host") %>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100 dark:divide-gray-700">
        <% records.each do |record| %>
          <tr>
            <td class="px-4 py-3 font-mono text-gray-800 dark:text-gray-200 font-medium">
              <%= record["priority"] %>
            </td>
            <td class="px-4 py-3 font-mono text-gray-800 dark:text-gray-200 break-all">
              <%= record["host"] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>

  </div>
</turbo-frame>
