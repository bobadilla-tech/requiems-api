<%
  rows = [
    { key: "label_syntax",     value: data["syntax_valid"], type: :bool },
    { key: "label_mx_record",  value: data["mx_valid"],     type: :bool },
    { key: "label_disposable", value: data["disposable"],   type: :bool_inv },
    { key: "label_valid",      value: data["valid"],        type: :bool },
    { key: "label_normalized", value: data["normalized"],   type: :text },
    { key: "label_domain",     value: data["domain"],       type: :text },
  ]
  rows << { key: "label_suggestion", value: data["suggestion"], type: :suggestion } if data["suggestion"].present?

  value_class = ->(type, val) {
    case type
    when :bool     then val ? "text-emerald-600 dark:text-emerald-400" : "text-red-500 dark:text-red-400"
    when :bool_inv then val ? "text-red-500 dark:text-red-400" : "text-emerald-600 dark:text-emerald-400"
    when :suggestion then "text-amber-600 dark:text-amber-400"
    else "text-gray-800 dark:text-gray-200"
    end
  }
%>
<turbo-frame id="email_validator-demo-result">
  <div class="mt-4 text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center gap-2">
      <span class="text-xs font-mono text-gray-500 dark:text-gray-400 truncate"><%= email %></span>
      <span class="ml-auto shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium <%= data["valid"] ? "bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300" : "bg-red-100 text-red-700 dark:bg-red-900 dark:text-red-300" %>">
        <%= data["valid"] ? t("shared.common.valid") : t("shared.common.invalid") %>
      </span>
    </div>

    <div class="px-4 py-1">
      <% rows.each do |row| %>
        <div class="flex items-center justify-between py-2 border-b border-gray-100 dark:border-gray-700 last:border-0">
          <span class="text-sm text-gray-500 dark:text-gray-400">
            <%= t("tools.email_validator.demo.#{row[:key]}") %>
          </span>
          <span class="text-sm font-medium <%= value_class.call(row[:type], row[:value]) %>">
            <% case row[:type] %>
            <% when :bool %>
              <%= row[:value] ? t("shared.common.yes") : t("shared.common.no") %>
            <% when :bool_inv %>
              <%= row[:value] ? t("tools.email_validator.demo.badge_disposable") : t("tools.email_validator.demo.badge_not_disposable") %>
            <% when :suggestion %>
              <%= "#{t("tools.email_validator.demo.suggestion_prefix")} #{row[:value]}?" %>
            <% else %>
              <%= row[:value].presence || "—" %>
            <% end %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>
