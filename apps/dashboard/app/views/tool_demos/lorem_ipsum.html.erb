<turbo-frame id="lorem_ipsum-demo-result">
  <div class="mt-4 text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center justify-between gap-3">
      <span class="text-sm font-semibold text-gray-900 dark:text-white">
        <%= t("tools.lorem_ipsum.demo.result_heading") %>
      </span>
      <span class="shrink-0 inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-amber-100 text-amber-700 dark:bg-amber-900 dark:text-amber-300">
        <%= t("tools.lorem_ipsum.demo.label_word_count", count: data["word_count"]) %>
      </span>
    </div>
    <div class="px-4 py-4">
      <p class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line"><%= data["text"] %></p>
    </div>
  </div>
</turbo-frame>
