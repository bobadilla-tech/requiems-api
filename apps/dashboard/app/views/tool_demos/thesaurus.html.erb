<%
  synonyms = Array(data["synonyms"])
  antonyms = Array(data["antonyms"])
%>
<turbo-frame id="thesaurus-demo-result">
  <div class="mt-4 text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 divide-y divide-gray-100 dark:divide-gray-700 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center gap-2">
      <span class="text-sm font-mono text-gray-900 dark:text-white truncate"><%= data["word"] %></span>
      <span class="ml-auto shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">
        <%= t("tools.thesaurus.demo.badge_found") %>
      </span>
    </div>

    <div class="px-4 py-4 space-y-4">
      <div>
        <span class="text-sm text-gray-500 dark:text-gray-400"><%= t("tools.thesaurus.demo.label_synonyms") %></span>
        <div class="mt-2 flex flex-wrap gap-2">
          <% if synonyms.any? %>
            <% synonyms.each do |word| %>
              <span class="text-xs px-2 py-1 rounded-full bg-emerald-50 dark:bg-emerald-900/30 text-emerald-700 dark:text-emerald-300">
                <%= word %>
              </span>
            <% end %>
          <% else %>
            <span class="text-sm text-gray-400 dark:text-gray-500">—</span>
          <% end %>
        </div>
      </div>

      <div>
        <span class="text-sm text-gray-500 dark:text-gray-400"><%= t("tools.thesaurus.demo.label_antonyms") %></span>
        <div class="mt-2 flex flex-wrap gap-2">
          <% if antonyms.any? %>
            <% antonyms.each do |word| %>
              <span class="text-xs px-2 py-1 rounded-full bg-red-50 dark:bg-red-900/30 text-red-700 dark:text-red-300">
                <%= word %>
              </span>
            <% end %>
          <% else %>
            <span class="text-sm text-gray-400 dark:text-gray-500">—</span>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</turbo-frame>
