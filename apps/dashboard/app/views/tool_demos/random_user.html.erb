<turbo-frame id="random_user-demo-result">
  <div class="mt-4 text-left rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 overflow-hidden">
    <div class="px-4 py-3 bg-gray-50 dark:bg-gray-900 flex items-center gap-3 border-b border-gray-100 dark:border-gray-700">
      <% if data["avatar"].present? %>
        <img src="<%= data["avatar"] %>"
             alt="<%= t("tools.random_user.demo.avatar_alt") %>"
             class="w-8 h-8 rounded-full shrink-0"
             loading="lazy">
      <% end %>
      <span class="text-sm font-semibold text-gray-900 dark:text-white truncate"><%= data["name"] %></span>
      <span class="ml-auto shrink-0 inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900 dark:text-emerald-300">
        <%= t("tools.random_user.demo.badge_live") %>
      </span>
    </div>

    <div class="px-4 py-1">
      <% fields = [
        { label: t("tools.random_user.demo.label_name"),    value: data["name"] },
        { label: t("tools.random_user.demo.label_email"),   value: data["email"] },
        { label: t("tools.random_user.demo.label_phone"),   value: data["phone"] },
        { label: t("tools.random_user.demo.label_street"),  value: data.dig("address", "street") },
        { label: t("tools.random_user.demo.label_city"),    value: data.dig("address", "city") },
        { label: t("tools.random_user.demo.label_state"),   value: data.dig("address", "state") },
        { label: t("tools.random_user.demo.label_zip"),     value: data.dig("address", "zip") },
        { label: t("tools.random_user.demo.label_country"), value: data.dig("address", "country") },
      ] %>
      <% fields.each_with_index do |field, i| %>
        <div class="flex items-center justify-between py-2 <%= i < fields.length - 1 ? 'border-b border-gray-100 dark:border-gray-700' : '' %>">
          <span class="text-sm text-gray-500 dark:text-gray-400"><%= field[:label] %></span>
          <span class="text-sm font-mono text-gray-800 dark:text-gray-200">
            <%= field[:value].presence || "—" %>
          </span>
        </div>
      <% end %>
    </div>
  </div>
</turbo-frame>
