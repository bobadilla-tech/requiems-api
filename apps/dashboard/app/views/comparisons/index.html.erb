<% content_for :title, t("comparisons.hub.meta_title") %>
<% content_for :description, t("comparisons.hub.meta_description") %>

<%# Hero %>
<section class="bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 text-white py-16 sm:py-20">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
      <%= t("comparisons.hub.hero_headline") %>
    </h1>
    <p class="text-lg sm:text-xl text-blue-100 max-w-2xl mx-auto leading-relaxed mb-8">
      <%= t("comparisons.hub.hero_subheadline") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
      <%= link_to new_user_registration_path,
                  class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold text-slate-900 bg-white hover:bg-blue-50 shadow-lg transition-colors w-full sm:w-auto" do %>
        <%= t("comparisons.hub.hero_cta_primary") %>
        <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
      <%= link_to api_reference_path,
                  class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold border-2 border-white/30 text-white hover:bg-white/10 transition-colors w-full sm:w-auto" do %>
        <%= t("comparisons.hub.hero_cta_secondary") %>
      <% end %>
    </div>
  </div>
</section>

<%# Philosophy strip %>
<section class="py-12 bg-white dark:bg-gray-900 border-b border-gray-100 dark:border-gray-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <h2 class="text-xl font-bold text-gray-900 dark:text-gray-100 text-center mb-8">
      <%= t("comparisons.hub.philosophy_heading") %>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="flex flex-col items-start p-6 rounded-xl bg-gray-50 dark:bg-gray-800/60 border border-gray-100 dark:border-gray-700">
        <div class="h-10 w-10 rounded-lg bg-blue-100 dark:bg-blue-900/50 flex items-center justify-center mb-4">
          <svg class="h-5 w-5 text-blue-600 dark:text-blue-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2"><%= t("comparisons.hub.philosophy_breadth_title") %></h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed"><%= t("comparisons.hub.philosophy_breadth_body") %></p>
      </div>

      <div class="flex flex-col items-start p-6 rounded-xl bg-gray-50 dark:bg-gray-800/60 border border-gray-100 dark:border-gray-700">
        <div class="h-10 w-10 rounded-lg bg-green-100 dark:bg-green-900/50 flex items-center justify-center mb-4">
          <svg class="h-5 w-5 text-green-600 dark:text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2"><%= t("comparisons.hub.philosophy_pricing_title") %></h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed"><%= t("comparisons.hub.philosophy_pricing_body") %></p>
      </div>

      <div class="flex flex-col items-start p-6 rounded-xl bg-gray-50 dark:bg-gray-800/60 border border-gray-100 dark:border-gray-700">
        <div class="h-10 w-10 rounded-lg bg-indigo-100 dark:bg-indigo-900/50 flex items-center justify-center mb-4">
          <svg class="h-5 w-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
          </svg>
        </div>
        <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-2"><%= t("comparisons.hub.philosophy_dx_title") %></h3>
        <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed"><%= t("comparisons.hub.philosophy_dx_body") %></p>
      </div>
    </div>
  </div>
</section>

<%# Benchmark summary table %>
<section class="py-14 bg-gray-50 dark:bg-gray-950 border-b border-gray-200 dark:border-gray-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 text-center mb-2">
      <%= t("comparisons.hub.benchmarks_heading") %>
    </h2>
    <p class="text-sm text-gray-500 dark:text-gray-400 text-center mb-8">
      <%= t("comparisons.hub.benchmarks_caption") %>
    </p>

    <div class="overflow-x-auto rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm">
      <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700 bg-white dark:bg-gray-900">
        <thead class="bg-gray-50 dark:bg-gray-800">
          <tr>
            <th class="py-3.5 px-4 text-left text-sm font-semibold text-gray-900 dark:text-gray-100 w-48">
              <%= t("comparisons.hub.benchmarks_feature") %>
            </th>
            <th class="py-3.5 px-4 text-center text-sm font-semibold text-blue-600 dark:text-blue-400 bg-blue-50 dark:bg-blue-900/20">
              <%= t("comparisons.hub.benchmarks_ours") %>
            </th>
            <% %w[zerobounce neverbounce ipstack abstractapi].each do |slug| %>
              <th class="py-3.5 px-4 text-center text-sm font-semibold text-gray-700 dark:text-gray-300">
                <%= t("comparisons.hub.benchmarks_columns.#{slug}") %>
              </th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          <% t("comparisons.hub.benchmarks_rows").each do |row| %>
            <tr class="hover:bg-gray-50 dark:hover:bg-gray-800/50">
              <td class="py-3 px-4 text-sm text-gray-700 dark:text-gray-300 font-medium"><%= row[:label] %></td>
              <%# Requiems API column — always highlighted %>
              <td class="py-3 px-4 text-center bg-blue-50/50 dark:bg-blue-900/10">
                <% if row[:ours] == true %>
                  <svg class="h-5 w-5 text-green-500 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                  </svg>
                  <span class="sr-only">Yes</span>
                <% elsif row[:ours] == false %>
                  <svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                  <span class="sr-only">No</span>
                <% else %>
                  <span class="text-xs font-medium text-blue-700 dark:text-blue-300"><%= row[:ours] %></span>
                <% end %>
              </td>
              <% %w[zerobounce neverbounce ipstack abstractapi].each do |slug| %>
                <td class="py-3 px-4 text-center">
                  <% val = row[slug.to_sym] %>
                  <% if val == true %>
                    <svg class="h-5 w-5 text-green-500 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                    </svg>
                    <span class="sr-only">Yes</span>
                  <% elsif val == false %>
                    <svg class="h-5 w-5 text-gray-300 dark:text-gray-600 mx-auto" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                      <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
                    </svg>
                    <span class="sr-only">No</span>
                  <% else %>
                    <span class="text-xs text-gray-600 dark:text-gray-400"><%= val %></span>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<%# Competitor cards grid %>
<section class="py-14 bg-white dark:bg-gray-900">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100 text-center mb-10">
      <%= t("comparisons.hub.competitors_heading") %>
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <% @competitors.each do |competitor| %>
        <%= render "partials/comparisons/competitor_card", competitor: competitor %>
      <% end %>
    </div>
  </div>
</section>

<%# Migration CTA %>
<section class="py-16 bg-gray-50 dark:bg-gray-950 border-t border-gray-100 dark:border-gray-800">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 dark:text-gray-100 mb-4">
      <%= t("comparisons.hub.migration_heading") %>
    </h2>
    <p class="text-lg text-gray-600 dark:text-gray-300 mb-8 leading-relaxed">
      <%= t("comparisons.hub.migration_body") %>
    </p>
    <div class="flex flex-col sm:flex-row gap-3 justify-center items-center">
      <%= link_to docs_path,
                  class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 shadow-lg transition-colors w-full sm:w-auto" do %>
        <%= t("comparisons.hub.migration_cta") %>
        <svg class="ml-2 h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
      <%= link_to new_user_registration_path,
                  class: "inline-flex items-center justify-center px-8 py-3.5 rounded-lg font-semibold border-2 border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-100 hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors w-full sm:w-auto" do %>
        <%= t("comparisons.hub.hero_cta_primary") %>
      <% end %>
    </div>
  </div>
</section>
