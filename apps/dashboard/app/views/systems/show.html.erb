<% slug = @system[:slug] %>
<% i18n = "systems.#{slug}" %>
<% content_for :title, t("#{i18n}.meta_title") %>
<% content_for :description, t("#{i18n}.hero.subheadline") %>
<% content_for :head do %>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css" integrity="sha512-N1r2z9dbzkqXrkCNQxofuhr7x2z5gQHWRHq62EtSqGFDSQyKM/lMgXWZi7w2NamRFT8dHem0D3j5M67d/M6QjQ==" crossorigin="anonymous">
<% end %>

<%# Hero %>
<div class="bg-gradient-to-br from-slate-900 via-slate-800 to-indigo-900 text-white py-20">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <%= link_to systems_path, class: "inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-white transition-colors mb-8" do %>
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
      </svg>
      <%= t("systems.show.back") %>
    <% end %>
    <p class="text-xs font-semibold uppercase tracking-widest text-indigo-300 mb-3">
      <%= t("#{i18n}.kicker") %>
    </p>
    <h1 class="text-4xl sm:text-5xl font-bold mb-6 leading-tight max-w-3xl">
      <%= t("#{i18n}.hero.headline") %>
    </h1>
    <p class="text-xl text-slate-300 max-w-2xl mb-10">
      <%= t("#{i18n}.hero.subheadline") %>
    </p>
    <% unless user_signed_in? %>
      <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-medium rounded-lg text-indigo-700 bg-white hover:bg-gray-50 transition-colors shadow-lg" do %>
        <%= t("#{i18n}.hero.primary_cta") %>
        <svg class="ml-2 h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
        </svg>
      <% end %>
    <% end %>
  </div>
</div>

<%# Engine showcase %>
<section style="background-color:#0a0f1a;" class="py-20 border-b border-white/5">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <div class="mb-10">
      <p class="text-xs font-semibold uppercase tracking-widest text-blue-400 mb-3">
        <%= t("systems.show.engine_label") %>
      </p>
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">
        <%= t("#{i18n}.engine.name") %>
      </h2>
      <p class="text-lg text-slate-300 max-w-2xl">
        <%= t("#{i18n}.engine.headline") %>
      </p>
    </div>

    <%# Request / Response side by side %>
    <div class="grid lg:grid-cols-2 gap-4" data-controller="highlight">
      <%# Request %>
      <div class="rounded-2xl overflow-hidden" style="background-color:#0d1117; border:1px solid rgba(255,255,255,0.08); box-shadow:0 20px 40px rgba(0,0,0,0.4);">
        <div class="px-4 py-3 flex items-center gap-3" style="background-color:#161b22; border-bottom:1px solid rgba(255,255,255,0.06);">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full" style="background:#ff5f57;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#febc2e;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#28c840;"></div>
          </div>
          <div class="flex items-center gap-2 ml-1">
            <span class="text-xs font-bold font-mono px-1.5 py-0.5 rounded" style="background:rgba(96,165,250,0.15); color:#93c5fd;">
              <%= t("#{i18n}.engine.endpoint_method") %>
            </span>
            <span class="text-xs font-mono" style="color:#94a3b8;"><%= t("#{i18n}.engine.endpoint_path") %></span>
          </div>
          <span class="ml-auto text-xs font-mono" style="color:#64748b;"><%= t("systems.show.request_label") %></span>
        </div>
        <pre class="px-5 py-5 text-sm font-mono leading-relaxed overflow-x-auto !bg-transparent m-0"><code class="language-json"><%= t("#{i18n}.engine.input") %></code></pre>
      </div>

      <%# Response %>
      <div class="rounded-2xl overflow-hidden" style="background-color:#0d1117; border:1px solid rgba(255,255,255,0.08); box-shadow:0 20px 40px rgba(0,0,0,0.4);">
        <div class="px-4 py-3 flex items-center gap-3" style="background-color:#161b22; border-bottom:1px solid rgba(255,255,255,0.06);">
          <div class="flex gap-1.5">
            <div class="w-2.5 h-2.5 rounded-full" style="background:#ff5f57;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#febc2e;"></div>
            <div class="w-2.5 h-2.5 rounded-full" style="background:#28c840;"></div>
          </div>
          <span class="ml-auto text-xs font-mono" style="color:#64748b;"><%= t("systems.show.response_label") %></span>
        </div>
        <pre class="px-5 py-5 text-sm font-mono leading-relaxed overflow-x-auto !bg-transparent m-0"><code class="language-json"><%= t("#{i18n}.engine.output") %></code></pre>
      </div>
    </div>
  </div>
</section>

<%# Purpose %>
<section class="bg-white dark:bg-gray-900 py-16 border-b border-gray-100 dark:border-gray-800">
  <div class="max-w-5xl mx-auto px-4 sm:px-6">
    <p class="text-lg text-gray-700 dark:text-gray-300 leading-relaxed max-w-3xl">
      <%= t("#{i18n}.purpose") %>
    </p>
  </div>
</section>

<%# API Reference — full docs with sidebar %>
<% if @documentation %>
  <section id="api-reference" class="bg-gray-50 dark:bg-gray-950 py-12 border-t border-gray-100 dark:border-gray-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="mb-8 max-w-5xl">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-gray-100"><%= t('systems.show.api_reference') %></h2>
        <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
          Base URL: <code class="font-mono text-xs bg-gray-100 dark:bg-gray-800 px-2 py-0.5 rounded"><%= @documentation["base_url"] %></code>
        </p>
      </div>

      <div class="lg:grid lg:grid-cols-12 lg:gap-8">
        <%# Sticky sidebar %>
        <aside class="hidden lg:block lg:col-span-3">
          <div class="sticky top-8">
            <nav class="space-y-1" data-controller="scroll-spy">
              <a href="#ref-overview" class="block px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors"><%= t('home.privacy.overview.heading') %></a>
              <a href="#ref-endpoints" class="block px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors"><%= t('systems.show.endpoints') %></a>
              <% @documentation["endpoints"]&.each_with_index do |endpoint, index| %>
                <a href="#endpoint-<%= index %>" class="block pl-6 py-2 text-sm text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-gray-200 transition-colors">
                  <span class="inline-block text-xs font-bold font-mono mr-1.5 <%= endpoint["method"] == 'POST' ? 'text-blue-600 dark:text-blue-400' : 'text-green-600 dark:text-green-400' %>"><%= endpoint["method"] %></span>
                  <%= endpoint["name"] %>
                </a>
              <% end %>
              <% if @documentation["faq"].present? %>
                <a href="#ref-faq" class="block px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg transition-colors">FAQ</a>
              <% end %>
            </nav>

            <%# Powered by %>
            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 dark:text-gray-500 mb-3">
                <%= t("systems.show.powered_by") %>
              </p>
              <div class="flex flex-wrap gap-2">
                <% @system[:division_slugs].each do |div_slug| %>
                  <%= link_to division_path(div_slug), class: "inline-flex items-center gap-1.5 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 px-3 py-1.5 text-xs font-medium text-gray-700 dark:text-gray-300 hover:border-blue-300 dark:hover:border-blue-600 transition-colors" do %>
                    <%= t("divisions.index.cards.#{div_slug}.title") %>
                  <% end %>
                <% end %>
              </div>
            </div>

            <%# Performance %>
            <% if @documentation["performance"].present? %>
              <% perf = @documentation["performance"] %>
              <div class="mt-6 rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 p-4">
                <div class="mb-3">
                  <span class="text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"><%= t('shared.common.performance') %></span>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-500 dark:text-gray-400">p50<span class="text-gray-400 dark:text-gray-500">&mdash; median</span></span>
                    <span class="text-sm font-semibold text-gray-800 dark:text-gray-200"><%= perf["p50_ms"] %> <span class="text-xs font-normal text-gray-400">ms</span></span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-500 dark:text-gray-400">p95</span>
                    <span class="text-sm font-semibold text-gray-800 dark:text-gray-200"><%= perf["p95_ms"] %> <span class="text-xs font-normal text-gray-400">ms</span></span>
                  </div>
                  <div class="flex items-center justify-between">
                    <span class="text-xs text-gray-500 dark:text-gray-400">p99<span class="text-gray-400 dark:text-gray-500">&mdash; tail</span></span>
                    <span class="text-sm font-semibold text-gray-800 dark:text-gray-200"><%= perf["p99_ms"] %> <span class="text-xs font-normal text-gray-400">ms</span></span>
                  </div>
                </div>
              </div>
            <% end %>
          </div>
        </aside>

        <%# Main content %>
        <main class="lg:col-span-9 mt-8 lg:mt-0">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow">

            <%# Overview %>
            <div id="ref-overview" class="p-8 border-b border-gray-200 dark:border-gray-700">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-4"><%= t('home.privacy.overview.heading') %></h3>

              <% if @documentation.dig("overview", "use_cases").present? %>
                <div class="mb-6">
                  <h4 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= t('systems.show.use_cases') %></h4>
                  <ul class="space-y-2">
                    <% @documentation.dig("overview", "use_cases").each do |use_case| %>
                      <li class="flex items-start">
                        <svg class="h-5 w-5 text-green-500 mr-2 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                        </svg>
                        <span class="text-gray-700 dark:text-gray-300"><%= use_case %></span>
                      </li>
                    <% end %>
                  </ul>
                </div>
              <% end %>

              <% if @documentation.dig("overview", "features").present? %>
                <div>
                  <h4 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-3"><%= t('home.changelog.v002.features.heading') %></h4>
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                    <% @documentation.dig("overview", "features").each do |feature| %>
                      <div class="flex items-start">
                        <svg class="h-5 w-5 text-blue-500 mr-2 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                        </svg>
                        <span class="text-gray-700 dark:text-gray-300 text-sm"><%= feature %></span>
                      </div>
                    <% end %>
                  </div>
                </div>
              <% end %>
            </div>

            <%# Endpoints %>
            <div id="ref-endpoints" class="p-8">
              <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6"><%= t('systems.show.api_endpoints') %></h3>

              <% @documentation["endpoints"]&.each_with_index do |endpoint, index| %>
                <%= render "partials/apis_show/endpoint_documentation",
                    endpoint: endpoint,
                    index: index,
                    base_url: @documentation["base_url"] %>
              <% end %>
            </div>

            <%# FAQ %>
            <% if @documentation["faq"].present? %>
              <div id="ref-faq" class="p-8 border-t border-gray-200 dark:border-gray-700">
                <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100 mb-6"><%= t('shared.faq_heading') %></h3>
                <div class="space-y-4" data-controller="faq-accordion">
                  <% @documentation["faq"].each_with_index do |faq, index| %>
                    <div class="border border-gray-200 dark:border-gray-700 rounded-lg">
                      <button type="button"
                              class="w-full px-6 py-4 text-left flex items-center justify-between hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
                              data-action="click->faq-accordion#toggle"
                              data-faq-accordion-target="button">
                        <span class="font-medium text-gray-900 dark:text-gray-100"><%= faq["question"] %></span>
                        <svg class="h-5 w-5 text-gray-500 dark:text-gray-400 transition-transform shrink-0 ml-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                        </svg>
                      </button>
                      <div class="hidden px-6 pb-4 text-gray-700 dark:text-gray-300" data-faq-accordion-target="content">
                        <%= faq["answer"] %>
                      </div>
                    </div>
                  <% end %>
                </div>
              </div>
            <% end %>

          </div>
        </main>
      </div>
    </div>
  </section>
<% end %>

<%# Final CTA %>
<section class="bg-slate-900 py-16">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 text-center">
    <h2 class="text-3xl font-bold text-white mb-4">
      <%= t("systems.index.hero.headline") %>
    </h2>
    <p class="text-slate-300 mb-8"><%= t("systems.index.hero.subheadline") %></p>
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <% unless user_signed_in? %>
        <%= link_to new_user_registration_path, class: "inline-flex items-center justify-center px-8 py-4 border border-transparent text-base font-medium rounded-lg text-indigo-700 bg-white hover:bg-gray-50 transition-colors shadow-lg" do %>
          <%= t("systems.show.get_started") %>
        <% end %>
      <% end %>
      <%= link_to divisions_path, class: "inline-flex items-center justify-center px-8 py-4 border-2 border-white/40 text-base font-medium rounded-lg text-white hover:bg-white/10 transition-colors" do %>
        <%= t("systems.show.explore_divisions") %>
      <% end %>
    </div>
  </div>
</section>
