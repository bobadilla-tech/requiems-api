{
  email admin@requiems.xyz
}

# Caddy is the stable public edge. Kamal Proxy remains the deployment-aware
# router behind it and listens on 127.0.0.1:8080/8443.

# Main application (landing page, dashboard, admin, docs)
requiems.xyz {
  # Exclude sitemaps from gzip — Googlebot HEAD requests fail when the gzip
  # Content-Length doesn't match, causing "Couldn't fetch" in Search Console.
  @compressible {
    not path /sitemap*.xml
  }

  encode @compressible zstd gzip

  @locale_bare {
    path_regexp ^/(en|es|fr)$
  }

  redir @locale_bare {uri}/ 301

  reverse_proxy 127.0.0.1:8080 {
    header_up Host {host}
  }
}

# MCP server (public — request authentication is handled by the MCP service).
mcp.requiems.xyz {
  reverse_proxy 127.0.0.1:8080 {
    header_up Host {host}
  }
}

# Public API. Cloudflare AOP is enforced at this edge before the request can
# reach Kamal Proxy or Go.
api.requiems.xyz {
  encode gzip

  tls {
    client_auth {
      mode require_and_verify
      trust_pool file {
        pem_file /etc/caddy/certs/cloudflare-origin-pull-ca.pem
      }
    }
  }

  reverse_proxy 127.0.0.1:8080 {
    header_up Host {host}
  }
}

