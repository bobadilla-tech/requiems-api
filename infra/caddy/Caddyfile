{
  email admin@requiems.xyz
}

# Main application (landing page, dashboard, admin, docs)
requiems.xyz {
  # Exclude sitemaps from gzip — Googlebot HEAD requests fail when the gzip
  # Content-Length doesn't match, causing "Couldn't fetch" in Search Console.
  @compressible {
    not path /sitemap*.xml
  }
  encode @compressible zstd gzip

  # Locale root paths without trailing slash: /en → /en/, /es → /es/, /fr → /fr/
  @locale_bare {
    path_regexp ^/(en|es|fr)$
  }
  redir @locale_bare {uri}/ 301

  reverse_proxy dashboard:80
}

# MCP server (public — auth is per-request via the requiems-api-key header,
# validated downstream by the auth-gateway Worker, not gated here)
mcp.requiems.xyz {
  reverse_proxy mcp:3000
}

# Internal backend API (only accessible via Cloudflare Worker)
internal.requiems.xyz {
  encode gzip

  # Add X-Backend-Secret header verification
  @authorized {
    header X-Backend-Secret {env.BACKEND_SECRET}
  }

  handle @authorized {
    reverse_proxy api:8080
  }

  handle {
    respond "Unauthorized" 403
  }
}


