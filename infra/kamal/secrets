# Hetzner VPS IP (host for servers and accessories).
HETZNER_VPS_IP=$HETZNER_VPS_IP

# GitHub Container Registry credentials.
KAMAL_REGISTRY_USERNAME=$KAMAL_REGISTRY_USERNAME
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# PostgreSQL accessory credentials.
POSTGRES_USER=$POSTGRES_USER
POSTGRES_PASSWORD=$POSTGRES_PASSWORD
POSTGRES_DB=$POSTGRES_DB

# Go API and Rails dashboard (hosts reference the `db`/`redis` accessory names).
DATABASE_URL=$DATABASE_URL
REDIS_URL=$REDIS_URL

# Sent as `X-Backend-Secret` by the auth-gateway Worker and Rails dashboard
# to authenticate to the Go API.
BACKEND_SECRET=$BACKEND_SECRET

# Rails dashboard.
SECRET_KEY_BASE=$SECRET_KEY_BASE
# Rails -> API Management worker (sent as `X-API-Management-Key`).
API_MANAGEMENT_API_KEY=$API_MANAGEMENT_API_KEY
# Lemon Squeezy webhook signature.
LEMONSQUEEZY_SIGNING_SECRET=$LEMONSQUEEZY_SIGNING_SECRET
# Resend SMTP password.
SMTP_PASSWORD=$SMTP_PASSWORD
