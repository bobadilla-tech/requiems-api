# COMPOSE_BAKE enables Docker Compose to delegate builds to BuildKit/bake for faster builds
COMPOSE_BAKE=true

# PostgreSQL
POSTGRES_USER=requiem
POSTGRES_PASSWORD=requiem
POSTGRES_DB=requiem
DATABASE_URL=postgres://requiem:requiem@db:5432/requiem?sslmode=disable
# Dedicated database for Go's integration tests (go test ./...), so their
# self-contained fixture tables never collide with Rails' real migrations of
# the same table names. See infra/docker/postgres-init/01-create-test-db.sh
# and agents.md.
TEST_DATABASE_URL=postgres://requiem:requiem@db:5432/requiem_test?sslmode=disable

# Redis
# Set after measuring protected state, Sidekiq, and disposable-cache usage.
# Production deployment is refused when this value is omitted.
REDIS_MAXMEMORY=256mb
REDIS_URL=redis://redis:6379

# Go API
PORT=8080
VPN_DATABASE_PATH=dbs/IP2PROXY-LITE-PX2.BIN
VPN_ASN_DATABASE_PATH=dbs/GeoLite2-ASN.mmdb
LANGUAGETOOL_URL=http://languagetool:8010

# Rails
RAILS_ENV=development
SECRET_KEY_BASE=development_secret_key_base_change_in_production
INTERNAL_API_URL=http://api:8080

# Analytics (GA4 measurement ID — public, safe to commit)
GA4_MEASUREMENT_ID=G-LS6S9MEGTW

# Public playground/demo-form system API key. Not auto-provisioned: set this
# to a real requiem_<24-char-alnum> value, then run
# `bin/rails playground:provision_key` once to create the matching ApiKey row.
# PLAYGROUND_API_KEY=

# Explicit local credential used by Rails seed, MCP stdio mode, and load tests.
# Replace this format-valid example with a disposable key you own locally.
LOCAL_DEV_API_KEY=requiem_AAAAAAAAAAAAAAAAAAAAAAAA

# MCP server — direct Go API endpoint. HTTP mode forwards the caller's key;
# stdio mode receives LOCAL_DEV_API_KEY through the Compose command.
REQUIEMS_BASE_URL=http://api:8080

# Notifications
OBSERVER_EMAILS=eliaz@bobadilla.tech

# LemonSqueezy (store ID and variant IDs are public - visible in checkout URLs)
LEMONSQUEEZY_STORE_SLUG=ultirequiem
LEMONSQUEEZY_STORE_ID=241998
# LemonSqueezy Variant IDs (numeric) - used for webhook event matching
LEMONSQUEEZY_DEVELOPER_MONTHLY_VARIANT_ID=1296434
LEMONSQUEEZY_DEVELOPER_YEARLY_VARIANT_ID=1296449
LEMONSQUEEZY_BUSINESS_MONTHLY_VARIANT_ID=1296450
LEMONSQUEEZY_BUSINESS_YEARLY_VARIANT_ID=1296455
LEMONSQUEEZY_PROFESSIONAL_MONTHLY_VARIANT_ID=1296459
LEMONSQUEEZY_PROFESSIONAL_YEARLY_VARIANT_ID=1296460

LEMONSQUEEZY_DEVELOPER_MONTHLY_CHECKOUT_UUID=5e11cee2-5f80-4486-aeca-8e25511bd4ac
LEMONSQUEEZY_DEVELOPER_YEARLY_CHECKOUT_UUID=8562dd29-f28c-43fb-8aab-add364efe179
LEMONSQUEEZY_BUSINESS_MONTHLY_CHECKOUT_UUID=631bd9b8-61fb-42a8-8b72-395e280ae1c4
LEMONSQUEEZY_BUSINESS_YEARLY_CHECKOUT_UUID=f4145891-6a7c-4a92-ac86-aae539f39853
LEMONSQUEEZY_PROFESSIONAL_MONTHLY_CHECKOUT_UUID=75dbfba3-3cb0-4136-a677-61103798a663
LEMONSQUEEZY_PROFESSIONAL_YEARLY_CHECKOUT_UUID=7c892cc3-bc79-4c44-ba03-9cf432c38783

# Secrets - leave empty for local dev unless testing payments
LEMONSQUEEZY_API_KEY=ASK_YOUR_BACKEND_TEAM
LEMONSQUEEZY_SIGNING_SECRET=ASK_YOUR_BACKEND_TEAM

# Test mode — always true in dev (see docs/core/local-payment-testing.md). Override to false in .env.local only if needed.
LEMONSQUEEZY_TEST_MODE=true

# Your current ngrok hostname (e.g. unprized-unseditiously-marilynn.ngrok-free.dev) — no protocol, no trailing slash
NGROK_HOST=unprized-unseditiously-marilynn.ngrok-free.dev

# Test-mode signing secret (from the ngrok webhook configured in LemonSqueezy dashboard)
LEMONSQUEEZY_SIGNING_SECRET_TEST=ASK_YOUR_BACKEND_TEAM

# Test-mode variant IDs (from your LemonSqueezy test products)
LEMONSQUEEZY_DEVELOPER_MONTHLY_VARIANT_ID_TEST=1375069
LEMONSQUEEZY_DEVELOPER_YEARLY_VARIANT_ID_TEST=1375074
LEMONSQUEEZY_BUSINESS_MONTHLY_VARIANT_ID_TEST=1374985
LEMONSQUEEZY_BUSINESS_YEARLY_VARIANT_ID_TEST=1375068
LEMONSQUEEZY_PROFESSIONAL_MONTHLY_VARIANT_ID_TEST=1375075
LEMONSQUEEZY_PROFESSIONAL_YEARLY_VARIANT_ID_TEST=1375083

# Test-mode checkout UUIDs (from your LemonSqueezy test products)
LEMONSQUEEZY_DEVELOPER_MONTHLY_CHECKOUT_UUID_TEST=0bb45302-7f07-4679-a577-c43986403bbc
LEMONSQUEEZY_DEVELOPER_YEARLY_CHECKOUT_UUID_TEST=b2d19c12-ab1c-48d9-a879-80a87bc582fb
LEMONSQUEEZY_BUSINESS_MONTHLY_CHECKOUT_UUID_TEST=6ebef332-959b-47e4-91e9-72f94609ae79
LEMONSQUEEZY_BUSINESS_YEARLY_CHECKOUT_UUID_TEST=88e8feb2-2fc1-4da1-8fae-2264774e9f6d
LEMONSQUEEZY_PROFESSIONAL_MONTHLY_CHECKOUT_UUID_TEST=11d20e2e-75d6-417e-a5aa-6c617bcfa542
LEMONSQUEEZY_PROFESSIONAL_YEARLY_CHECKOUT_UUID_TEST=2b8f0899-8307-4df9-a19a-d9e3878b8674

# SMTP (password in .env.local)
SMTP_ADDRESS=smtp.resend.com
SMTP_PORT=587
SMTP_DOMAIN=mail.requiems.xyz
SMTP_USERNAME=resend
SMTP_FROM_EMAIL=noreply@mail.requiems.xyz
MAILER_HOST=requiems.xyz
SMTP_PASSWORD=ASK_YOUR_BACKEND_TEAM
